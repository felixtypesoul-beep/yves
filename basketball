-- ===== auto farm: stack every neck hitbox on one titan, dive at it from above and swing =====
-- Every live titan's Nape hitbox is detached from its titan (client side), made huge and kept on the titan being attacked.
-- The character then drops through that box from above and behind (well away from the mouth) with a real swing timed to
-- release just inside the box, and a hit is registered on every stacked neck in the same moment, so one dive can take
-- several titans down. When the target is down the stack moves to the next titan. Necks and welds are put back when the
-- farm is switched off.
local stackRelease, killLoop
do
local stackSaved = setmetatable({}, { __mode = "k" })
local stackWelds = {}
local stackHome = setmetatable({}, { __mode = "k" })
local atMe = false -- true while the necks are on me, false while they are back at their own place
local function stackAdopt(n)
    if stackSaved[n] then return end
    do local tt = n.Parent and n.Parent.Parent and n.Parent.Parent.Parent; local r = tt and root(tt); if r then stackHome[n] = { r, r.CFrame:ToObjectSpace(n.CFrame) } end end
    local o = original[n]
    stackSaved[n] = { o and o[1] or n.Size, o and o[2] or n.Transparency, o and o[3] or n.CanCollide, n.Anchored, o and o[4] or n.CanTouch, n.Color, n.Material }
    for _, holder in ipairs({ n.Parent, n }) do
        for _, w in ipairs(holder:GetChildren()) do
            if (w:IsA("Weld") or w:IsA("WeldConstraint")) and (w.Part0 == n or w.Part1 == n) then
                stackWelds[#stackWelds+1] = { w:Clone(), w.Parent }
                pcall(function() w:Destroy() end)
            end
        end
    end
    n.Anchored = true
    n.CanCollide = false
end
function stackRelease()
    for _, e in ipairs(stackWelds) do
        if e[2] and e[2].Parent then pcall(function() e[1].Parent = e[2] end) end
    end
    stackWelds = {}
    for n, o in pairs(stackSaved) do
        if n.Parent then
            n.Anchored = o[4]; n.Size = o[1]; n.Transparency = o[2]; n.CanCollide = o[3]; n.CanTouch = o[5]
            if o[6] then n.Color = o[6] end
            if o[7] then n.Material = o[7] end
        end
        stackSaved[n] = nil
    end
end
