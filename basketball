-- Flight: the character is moved a little every frame at up to S.Speed studs/s (position stepping, not a teleport).
-- Pushing the game's BodyVelocity is not enough: while standing on the ground the game's own movement code overrides it,
-- so the position is advanced directly and the physics velocity is zeroed so gravity cannot pull the character back.
local lastFlyT
local function driveVelocity(hrp, v)
    local now = tick()
    local dt = lastFlyT and math.min(now - lastFlyT, 0.1) or 0
    lastFlyT = now
    local bv = hrp:FindFirstChild("BV") or hrp:FindFirstChild("YvesBV")
    if not (bv and bv:IsA("BodyVelocity")) then
        bv = Instance.new("BodyVelocity")
        bv.Name = "YvesBV"
        bv.Parent = hrp
    end
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    hrp.AssemblyLinearVelocity = Vector3.zero
    if dt > 0 and v.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + v * dt
    end
end
local function stopFlying(hrp)
    driveVelocity(hrp, Vector3.zero)
    lastFlyT = nil
    local mine = hrp:FindFirstChild("YvesBV")
    if mine then mine:Destroy() end
end
-- Void guard (noclip + flying can drop you through the floor): remembers the last ground seen below us and, if
-- there is suddenly no ground under us at all, puts us back above it. Returns the ground height under us.
local lastSafe
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function guardVoid(hrp)
    rayParams.FilterDescendantsInstances = { lp.Character, workspace:FindFirstChild("Titans") }
    local res = workspace:Raycast(hrp.Position, Vector3.new(0, -4000, 0), rayParams)
    if res then
        lastSafe = res.Position + Vector3.new(0, 60, 0)
        return res.Position.Y
    end
    if lastSafe then
        hrp.CFrame = CFrame.new(lastSafe)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    return nil
end

-- ===== refill (blades + gas), straight through the game's remotes: no travelling =====
-- The station list used to be built once and kept forever: scanned in the lobby (or on the previous map) it stayed empty / full of
-- destroyed parts, so no map after that ever found a station and nothing refilled. It is now rescanned whenever it is empty,
-- stale or holds a destroyed part, and again on demand (force) before a trip.
local stations, stationsAt = nil, 0
local function findStations(force)
    local stale = force or not stations or #stations == 0 or tick() - stationsAt > 12
    if not stale then
        for _, p in ipairs(stations) do
            if not p.Parent then stale = true break end
        end
    end
    if stale then
        local list, seen = {}, {}
        local function add(p) if p and not seen[p] then seen[p] = true list[#list+1] = p end end
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") and d.Name == "Refill" then
                local a = d.Parent
                while a and a ~= workspace do
                    if a.Name == "GasTanks" then add(d) break end
                    a = a.Parent
                end
            end
        end
        if #list == 0 then -- other maps / raids: any part called Refill, or a part carrying a refill prompt
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("BasePart") and d.Name == "Refill" then
                    add(d)
                elseif d:IsA("ProximityPrompt") and ((d.ActionText or ""):lower():find("refill", 1, true) or (d.ObjectText or ""):lower():find("refill", 1, true)) then
                    local part = d.Parent
                    if part and part:IsA("BasePart") then add(part) end
                end
            end
        end
        stations, stationsAt = list, tick()
    end
    return stations
end
local function nearestStation(hrp)
    local function pick()
        local best, bd = nil, math.huge
        for _, p in ipairs(findStations()) do
            if p.Parent then
                local d = (p.Position - hrp.Position).Magnitude
                if d < bd then best, bd = p, d end
            end
        end
        return best
    end
    return pick() or (function() findStations(true) return pick() end)()
end
-- calling the remote directly does not refresh the HUD by itself, so mirror the change on the blade counter
local function setSets(cur, max)
    local f = hudTop()
    local s = f and f:FindFirstChild("Blades") and f.Blades:FindFirstChild("Sets")
    if s then s.Text = ("%d / %d"):format(math.max(cur, 0), max) end
end
-- fly to a goal with the boost-style mover (also keeps us from dropping through the floor)
local function flyTo(hrp, getGoal, tol, timeout)
    local t0 = tick()
    while tick() - t0 < timeout do
        local goal = getGoal()
        if not goal then break end
        local d = goal - hrp.Position
        if d.Magnitude <= tol then break end
        guardVoid(hrp)
        driveVelocity(hrp, d.Unit * math.min(S.Speed, d.Magnitude * 3 + 15))
        RunService.Heartbeat:Wait()
    end
    driveVelocity(hrp, Vector3.zero)
end
local busy = false -- true while a refill trip is running (the farm loop waits)
local reloadPause = false -- true while a blade swap is pending: the farm stops swinging so the game accepts the R key
local reloadFails = 0
local refilling = false
local setsLeft, setsMax, wasBroken = nil, 3, false
local refillCooldown = 0
-- The game hides the equipped blade (Transparency 1) the moment it breaks, while the HUD bar can still read full,
-- so that is the signal used here (same one the reference script watches).
local function bladeBroken()
    local ch = lp.Character
    local rig = ch and ch:FindFirstChild("Rig_" .. lp.Name)
    local hand = rig and rig:FindFirstChild("LeftHand")
    local blade = hand and hand:FindFirstChild("Blade_1")
    if blade and blade.Transparency == 1 and ch:GetAttribute("IFrames") == nil then return true end
    local _, _, dur = readBlades()
