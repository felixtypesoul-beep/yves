-- Refill trip (real interaction, no remote calls): teleport onto the nearest refill station, stand on it so the game's
-- own zone registers us, then use it the way a player does: fire the station's ProximityPrompt if it has one,
-- otherwise press R. Noclip is off while this runs so the character stands on the station instead of falling through.
local function stationPrompt(station)
    return station:FindFirstChildWhichIsA("ProximityPrompt", true)
        or (station.Parent and station.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
end
local function fullRefill()
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hrp or refilling then return end
    local station = nearestStation(hrp)
    if not station then return end
    refilling, busy = true, true -- the farm stays paused for the whole trip
    stats.state = "Refilling"
    -- the game's own mover (BV) can hold a NaN velocity; it is zeroed on every step of the trip.
    local function calm()
        local bvg = hrp:FindFirstChild("BV")
        if bvg and bvg:IsA("BodyVelocity") then bvg.Velocity = Vector3.zero; bvg.MaxForce = Vector3.zero end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    -- every animation that is playing on the character right now (the character and its rig each have an Animator)
    local function playingTracks()
        local out = {}
        if ch then
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("Animator") then
                    for _, tr in ipairs(d:GetPlayingAnimationTracks()) do out[tr] = true end
                end
            end
        end
        return out
    end
    local holdConn
    local ok, err = pcall(function()
        -- 1) teleport straight onto the refill station (works from every mode: legit farm, raid farm, auto farm).
        -- The spot is fixed up front and the character is held on it from the first frame: with noclip on (legit farm) it used to
        -- fall through the station while "landing" and was then parked underground, so the game never saw it in the zone.
        -- legit farm noclip: collisions come back FIRST, one frame passes, only then the teleport (otherwise the character fell through the station)
        if Boot.legitSolid then pcall(Boot.legitSolid) end
        stopFlying(hrp)
        calm()
        RunService.Stepped:Wait()
        RunService.Heartbeat:Wait()
        if Boot.legitSolid then pcall(Boot.legitSolid) end
        local spot = station.CFrame + Vector3.new(0, 3, 0)
        holdConn = RunService.Heartbeat:Connect(function()
            if hrp.Parent then calm(); hrp.CFrame = spot end
        end)
        hrp.CFrame = spot
        task.wait(0.5)
        -- 2) use it like a player (ProximityPrompt if there is one, otherwise R), then wait for the refill animation to finish
        for attempt = 1, 3 do
            local base = playingTracks()
            local pp = stationPrompt(station)
            if pp and fireproximityprompt then
                pcall(fireproximityprompt, pp)
            else
                pressKey(Enum.KeyCode.R)
            end
            -- wait for the refill animation to start (up to 2s)
            local started, t2 = false, tick()
            repeat
                task.wait(0.05)
                for tr in pairs(playingTracks()) do if not base[tr] then started = true break end end
            until started or tick() - t2 > 2
            if started then
                -- wait until every new animation has finished (up to 12s)
                local t3 = tick()
                while tick() - t3 < 12 do
                    local playing = false
                    for tr in pairs(playingTracks()) do if not base[tr] then playing = true break end end
                    if not playing then break end
                    task.wait(0.1)
                end
            else
                task.wait(2.5) -- no animation seen: give the refill a fixed moment instead
            end
            task.wait(0.5) -- let the HUD catch up
            local g = readGas()
            if not bladeBroken() and (g == nil or g > S.GasBelow) then break end
        end
        local _, max = readBlades()
        if not bladeBroken() then
            setsMax = (max and max > 0) and max or 3
            setsLeft = setsMax
        end
    end)
    if holdConn then holdConn:Disconnect() end
    calm()
    refillCooldown = tick() + 2
    -- 3) done: the farm loop sees busy = false and carries on from where it was (with auto farm off we simply stay here)
    refilling, busy = false, false
end
local brokenSince
local function refillStep()
    if refilling or tick() < refillCooldown then return end
    if not (titanFolder() or Boot.raidFarmOn or S.RaidMode) then wasBroken = false brokenSince = nil return end -- only while in a mission / raid
    local gas = readGas()
    local cur, max = readBlades()
    if setsLeft == nil then
        setsLeft = cur or 3
        setsMax = (max and max > 0) and max or 3
    end
    local broken = S.AutoReload and bladeBroken()
    if broken and not wasBroken then
        brokenSince = tick()
        setsLeft = math.max(setsLeft - 1, 0)
        setSets(setsLeft, setsMax)
    end
    if not broken then brokenSince = nil end
    wasBroken = broken
    local lowGas = S.AutoRefill and gas ~= nil and gas <= S.GasBelow
    -- blade still broken after a few swap attempts (or no spare sets left), or low on gas: go to the refill station
    local outOfSets = (cur ~= nil and cur <= 0) or (cur == nil and setsLeft <= 0) -- only when the HUD reads 0 / max
    if lowGas or (broken and S.AutoRefill and outOfSets) then
        task.spawn(fullRefill)
        refillCooldown = tick() + 3
    elseif broken then
        -- swap to a spare set with the game's own reload key. The game ignores R while a swing is in progress, so the farm
        -- is paused first (it finishes the dive it is in), then R is pressed until the blade is whole again.
        refillCooldown = tick() + 4
        task.spawn(function()
            reloadPause = true
            task.wait(0.9)
            local fixed = false
            for _ = 1, 4 do
                if not bladeBroken() then fixed = true break end
                pressKey(Enum.KeyCode.R)
                task.wait(0.7)
            end
            if not fixed and bladeBroken() then reloadFails += 1 else reloadFails = 0 end
            reloadPause = false
            -- R keeps failing with spare sets left: go to the station after all instead of staying stuck
            if reloadFails >= 3 and S.AutoRefill then reloadFails = 0; task.spawn(fullRefill) end
        end)
    end
end

