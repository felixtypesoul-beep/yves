-- ===== auto execute: re-run this hub after a rejoin / retry / teleport (until Roblox is closed) =====
-- Put your GitHub raw link here (recommended), e.g. "https://raw.githubusercontent.com/<user>/<repo>/refs/heads/main/aotr".
-- If it is left empty, the hub re-loads itself from the executor workspace file below.
-- A small on/off file gates every queued run: unloading the hub (or turning the toggle off) writes "off", so
-- nothing re-executes again until you run the script yourself.
local AUTO_URL = ""
local SELF_FILE = "YvesHub/Yves Aotr Paid.lua"
local AUTOEXEC_FLAG = "YvesHub/aotr_paid_autoexec.txt"
local HttpService = game:GetService("HttpService")
local function setAutoExecFlag(on)
    pcall(function()
        if not writefile then return end
        if makefolder and isfolder and not isfolder("YvesHub") then makefolder("YvesHub") end
        writefile(AUTOEXEC_FLAG, on and "on" or "off")
    end)
end
local queuedFor
-- Finds the NEWEST copy of this hub among the executor's workspace files (any file whose header is this hub's) and
-- copies it to SELF_FILE, so auto execute always re-runs the latest script you executed, not an old saved copy.
local HUB_MARK = "(PAID:" -- only this file's own header (the free scripts share the rest of the first line)
local function fileStamp(p)
    for _, name in ipairs({ "getfilemodifiedtime", "getfiletime", "getfilemodified" }) do
        local fn = getgenv()[name]
        if type(fn) == "function" then
            local ok, t = pcall(fn, p)
            if ok and type(t) == "number" then return t end
        end
    end
    return nil
end
local function syncNewestScript()
    pcall(function()
        if not (listfiles and isfile and readfile and writefile) then return end
        local best, bestT
        local seen = {}
        for _, dir in ipairs({ "", "YvesHub", "Scripts", "scripts", "workspace" }) do
            local okL, list = pcall(listfiles, dir)
            if okL and type(list) == "table" then
                for _, p in ipairs(list) do
                    local low = tostring(p):lower()
                    if not seen[p] and (low:match("%.lua$") or low:match("%.txt$") or low:match("%.luau$")) then
                        seen[p] = true
                        local okR, body = pcall(readfile, p)
                        if okR and type(body) == "string" and body:sub(1, 400):find(HUB_MARK, 1, true) then
                            local t = fileStamp(p) or 0
                            if not best or t >= bestT then best, bestT = p, t end
                        end
                    end
                end
            end
        end
        if best and best:gsub("\\", "/") ~= SELF_FILE then
            if makefolder and isfolder and not isfolder("YvesHub") then makefolder("YvesHub") end
            writefile(SELF_FILE, readfile(best))
        end
    end)
end
local AE = {} -- one table for the auto execute helpers (the script is at Luau's 200 local variable limit)
-- The link file: paste your GitHub raw link of this script in the Home tab (or set AUTO_URL above). It is remembered between sessions.
AE.AUTOURL_FILE = "YvesHub/aotr_paid_autourl.txt"
function AE.readAutoUrl()
    local url = AUTO_URL
    pcall(function()
        if isfile and isfile(AE.AUTOURL_FILE) then
            local t = tostring(readfile(AE.AUTOURL_FILE)):gsub("^%s+", ""):gsub("%s+$", "")
            if t:match("^https?://") then url = t end
        end
    end)
    return url
end
AE.AUTOEXEC_DIRS = { "autoexec", "Autoexec", "AutoExec", "autoexecute" } -- executor auto-execute folders (PC and mobile executors)
AE.AUTOEXEC_STUB = "yves_aotr_autoexec.lua"
-- the code that runs after a teleport / on the next join: only when the on/off file says "on", never twice within 30s, after the game loaded
function AE.bootCode(src)
    return ('local f = "%s" if isfile and (not isfile(f) or readfile(f) ~= "on") then return end local g = getgenv() '
        .. 'if g.AotrYvesBoot and os.clock() - g.AotrYvesBoot < 30 then return end g.AotrYvesBoot = os.clock() '
        .. 'if not game:IsLoaded() then game.Loaded:Wait() end task.wait(3) '
        .. 'local ok, e = pcall(function() %s end) if not ok then warn("Yves auto execute: " .. tostring(e)) end'):format(AUTOEXEC_FLAG, src)
end
function AE.scriptSource()
    local url = AE.readAutoUrl()
    if url ~= "" then return ('loadstring(game:HttpGet("%s"))()'):format(url) end
    syncNewestScript()
    if isfile and isfile(SELF_FILE) then return ('loadstring(readfile("%s"))()'):format(SELF_FILE) end
    return nil
end
-- the executor's own auto-execute folder: also covers a full rejoin / restart (queue_on_teleport only survives a teleport).
-- It is only written while Auto execute is on, only runs in this game, and is deleted when it is switched off.
function AE.writeAutoExecStub(src)
    pcall(function()
        if not (writefile and isfolder) then return end
        local dir
        for _, d in ipairs(AE.AUTOEXEC_DIRS) do if isfolder(d) then dir = d break end end
        if not dir and makefolder then pcall(makefolder, "autoexec") if isfolder("autoexec") then dir = "autoexec" end end
        if not dir then return end
        local body = ('if game.GameId ~= %d then return end\n%s'):format(game.GameId, AE.bootCode(src))
        writefile(dir .. "/" .. AE.AUTOEXEC_STUB, body)
    end)
end
function AE.removeAutoExecStub()
    pcall(function()
        if not (isfile and delfile) then return end
        for _, d in ipairs(AE.AUTOEXEC_DIRS) do
            local f = d .. "/" .. AE.AUTOEXEC_STUB
            if isfile(f) then delfile(f) end
        end
    end)
end
AE.autoExecWarned = false
function AE.queueReload()
    if not S.AutoExec then setAutoExecFlag(false) AE.removeAutoExecStub() return end
    local src = AE.scriptSource()
    if not src then
        -- nothing to re-run: say so once instead of failing silently
        if not AE.autoExecWarned then
            AE.autoExecWarned = true
            task.defer(function()
                pcall(function() Library:Notification({ Name = "Auto execute: paste your GitHub raw link in Home > Auto execute (or save the script as workspace/" .. SELF_FILE .. ")", Time = 8 }) end)
            end)
        end
        return
    end
    setAutoExecFlag(true)
    AE.writeAutoExecStub(src)
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or (getgenv and getgenv().queue_on_teleport)
    if not q then return end
    -- queue once per server: queue_on_teleport entries pile up, and several copies starting at once can crash the game
    if queuedFor == game.JobId then return end
    queuedFor = game.JobId
    pcall(q, AE.bootCode(src))
end

