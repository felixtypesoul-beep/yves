local function espStep()
    local cam = workspace.CurrentCamera
    local root = espRoot()
    local me = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local from = me and me.Position or cam.CFrame.Position
    local vp = cam.ViewportSize
    local live = {}
    for _, t in ipairs(titans()) do
        local fake = t:FindFirstChild("Fake")
        if fake and not titanDown(t) then
            live[t] = true
            local box = espBoxes[t]
            if not box then box = newBox(root); espBoxes[t] = box end
            local ok, cf, size = pcall(function() return fake:GetBoundingBox() end)
            local distance = ok and (from - cf.Position).Magnitude or math.huge
            local show = false
            if ok and distance <= S.ESPMax then
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local front = 0
                for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz = -1, 1, 2 do
                    local v = cam:WorldToViewportPoint(cf * Vector3.new(size.X / 2 * sx, size.Y / 2 * sy, size.Z / 2 * sz))
                    if v.Z > 0 then
                        front += 1
                        minX = math.min(minX, v.X); maxX = math.max(maxX, v.X)
                        minY = math.min(minY, v.Y); maxY = math.max(maxY, v.Y)
                    end
                end end end
                if front > 0 then
                    local cx, cy, w, h
                    if front == 8 then
                        w, h = maxX - minX, maxY - minY
                        cx, cy = (minX + maxX) / 2, (minY + maxY) / 2
                    else
                        -- partly behind the camera: size the box from the titan's centre and depth instead
                        local c, depthPos = nil, cam.CFrame:PointToObjectSpace(cf.Position)
                        local depth = -depthPos.Z
                        if depth > 1 then
                            c = cam:WorldToViewportPoint(cf.Position)
                            local scale = (vp.Y / 2) / math.tan(math.rad(cam.FieldOfView) / 2) / depth
                            cx, cy = c.X, c.Y
                            w, h = math.max(size.X, size.Z) * scale, size.Y * scale
                        end
                    end
                    if cx then
                        show = true
                        w, h = math.clamp(w, 12, vp.X * 1.5), math.clamp(h, 12, vp.Y * 1.5)
                        if cx + w / 2 < 0 or cx - w / 2 > vp.X or cy + h / 2 < 0 or cy - h / 2 > vp.Y then show = false end
                    box.frame.Position = UDim2.fromOffset(cx - w / 2, cy - h / 2)
                    box.frame.Size = UDim2.fromOffset(w, h)
                    box.stroke.Enabled = S.ESPBox
                    box.stroke.Color = ESPC.box
                    box.stroke.Thickness = S.ESPThick
                    box.name.Visible = S.ESPName
                    box.name.Text = S.ESPLabel
                    box.name.TextSize = S.ESPText
                    box.name.TextColor3 = ESPC.name
                    box.dist.Visible = S.ESPDist
                    box.dist.Text = ("%d studs"):format(distance)
                    box.dist.TextSize = S.ESPText
                    box.dist.TextColor3 = ESPC.dist
                    -- tracer: a line from the bottom centre of the screen to the titan
                    if S.ESPTracer then
                        local ax, ay = vp.X / 2, vp.Y
                        local dx, dy = cx - ax, cy - ay
                        box.tracer.Visible = true
                        box.tracer.BackgroundColor3 = ESPC.tracer
                        box.tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), S.ESPTracerT)
                        box.tracer.Position = UDim2.fromOffset(ax + dx / 2, ay + dy / 2)
                        box.tracer.Rotation = math.deg(math.atan2(dy, dx))
                    else
                        box.tracer.Visible = false
                    end
                    end
                end
            end
            box.frame.Visible = show
            if not show then box.tracer.Visible = false end
            -- glow (fill through walls)
            if S.ESPGlow and show then
                if not box.glow then
                    local hl = Instance.new("Highlight")
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = t
                    hl.Parent = root
                    box.glow = hl
                end
                box.glow.FillColor = ESPC.glow
                box.glow.OutlineColor = ESPC.glow
                box.glow.FillTransparency = S.ESPGlowT
            elseif box.glow then
                box.glow:Destroy(); box.glow = nil
            end
        end
    end
    for t, b in pairs(espBoxes) do
        if not live[t] then destroyBox(b); espBoxes[t] = nil end
    end
end
