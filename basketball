-- Raid tab (paid): open / start a raid from the lobby, farm inside it, and repeat
-- Uses the same lobby calls as the Lobby tab (S_Missions Create / Start / Leave) and the same dive farm as Auto Farm.
-- =====================================================================
do
    local RAIDS = {
        ["Attack Titan"] = { map = "Trost", obj = "Attack Titan" },
        ["Armored Titan"] = { map = "Shiganshina", obj = "Armored Titan" },
        ["Colossal Titan"] = { map = "Shiganshina", obj = "Colossal Titan" },
        ["Female Titan"] = { map = "Stohess", obj = "Female Titan" },
    }
    local R = { Raid = "Attack Titan", Diff = "Hard", Auto = false, Wait = 5, Farm = true, State = "Idle", Runs = 0 }
    local RAID_FLAG = "YvesHub/aotr_paid_raid_on.txt"
    local raidIntent = false
    pcall(function() if isfile and isfile(RAID_FLAG) and readfile(RAID_FLAG) == "1" then raidIntent = true end end)

    local function raidActive()
        local obj = workspace:GetAttribute("Objective")
        local on = type(obj) == "string" and obj:find("Titan", 1, true) ~= nil and workspace:FindFirstChild("Titans") ~= nil
        return on, obj
    end
    local function openRaid()
        local r = RAIDS[R.Raid]
        if not r then return false end
        local res = invoke("S_Missions", "Create", { Name = r.map, Difficulty = R.Diff, Type = "Raids", Objective = r.obj })
        if res == nil then
            notify("Raid lobby not opened (already in one, or locked)")
            return false
        end
        notify(("Raid lobby open: %s / %s"):format(R.Raid, R.Diff))
        return true
    end
    local function startRaid()
        local res = invoke("S_Missions", "Start")
        if res == nil and openRaid() then
            task.wait(0.5)
            res = invoke("S_Missions", "Start")
        end
        notify(res and "Starting raid..." or "Could not start the raid")
        return res ~= nil
    end
    -- ===== after the raid: open the chests, then send the raid report =====
    R.Chests, R.Prem, R.PremN, R.Wh = true, false, 1, false
    R.totalTime, R.done, R.cur = 0, 0, nil
    R.Skip = true
    task.spawn(function() -- auto skip cutscenes: press the game's own SKIP button the moment it shows
        local last = 0
        while not Boot.stopping do
            if R.Skip and tick() - last > 0.5 then
                local i = iface()
                local sk = i and i:FindFirstChild("Skip")
                if sk and isShown(sk) then
                    click(sk:FindFirstChild("Interact"))
                    last = tick()
                end
            end
            task.wait(0.15)
        end
    end)
    local function raidHealthPct()
        local i = iface()
        local p = i and i:FindFirstChild("Raids") and i.Raids:FindFirstChild("Health")
        p = p and p:FindFirstChild("Outer") and p.Outer:FindFirstChild("Backing") and p.Outer.Backing:FindFirstChild("Percentage")
        return p and tonumber(p.Text:match("[%d%.]+"))
    end
    local function chestScreen()
        local i = iface()
        local ch = i and i:FindFirstChild("Chests")
        if ch and isShown(ch) then return ch end
    end
    local function titansAlive()
        local n, f = 0, workspace:FindFirstChild("Titans")
        if f then for _, t in ipairs(f:GetChildren()) do if not titanDown(t) then n += 1 end end end
        return n
    end
    -- the raid is over once the chest screen is up: open the free chest (and premium ones if wanted), collect the item
    -- names the screen shows while a chest opens, press Finish, then send the report once
    local function handleChests()
        local ch = chestScreen()
        if not ch then return false end
        local rec = R.cur
        if rec and not rec.endT then
            rec.endT = tick()
            rec.cleared = titansAlive() == 0 or (rec.lastPct ~= nil and rec.lastPct <= 0.5)
            R.done += 1
            R.totalTime += rec.endT - rec.startT
        end
        local items, premOpened = {}, 0
        if R.Chests then
            R.State = "Opening chests"
            local title = ch:FindFirstChild("Title")
            local conn
            if title and title:IsA("TextLabel") then
                conn = title:GetPropertyChangedSignal("Text"):Connect(function()
                    local s = title.Text
                    if s ~= "" and s:upper() ~= "CHESTS" then items[#items+1] = s end
                end)
            end
            local free = ch:FindFirstChild("Free")
            if free and free.Visible then click(free); task.wait(3.5) end
            if R.Prem then
                local prem = ch:FindFirstChild("Premium")
