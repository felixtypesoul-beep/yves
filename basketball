-- ===== ODM gear tweaks =====
-- The game keeps the ODM stats and movement state in the character's Actor (a separate Lua state), so a small patcher
-- is run there with run_on_actor. It reads its settings from attributes on the local player and writes the stats
-- every frame; turning a feature off restores the original stat values.
local ODM_CODE = [==[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer
local gen = (lp:GetAttribute("YV_ODM_GEN") or 0) + 1
lp:SetAttribute("YV_ODM_GEN", gen)
local state, lastFind, tries = nil, 0, 0
local function findState()
    for _, v in ipairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "Loadout") ~= nil and rawget(v, "Cache") ~= nil and rawget(v, "Modules") ~= nil then return v end
    end
end
-- the original stat values are kept in the state table itself, so re-installing this patcher can never stack a boost on a boost
local function bases() state.YV_BASE = state.YV_BASE or {}; return state.YV_BASE end
local function tweak(st, key, on, fn)
    local b = bases()
    if on then
        if b[key] == nil then b[key] = st[key] end
        st[key] = fn(b[key])
    elseif b[key] ~= nil then
        st[key] = b[key]; b[key] = nil
    end
end
local conn
conn = RunService.Heartbeat:Connect(function()
    if lp:GetAttribute("YV_ODM_GEN") ~= gen then
        conn:Disconnect()
        if state and state.Loadout and state.Loadout.Stats and state.YV_BASE then
            for k, v in pairs(state.YV_BASE) do state.Loadout.Stats[k] = v end
            state.YV_BASE = {}
        end
        return
    end
    if not state then
        if tick() - lastFind < 2 then return end
        tries += 1
        if tries > 6 then conn:Disconnect(); return end -- never keep scanning memory forever
        lastFind = tick(); state = findState()
        if not state then return end
    end
    local st = state.Loadout and state.Loadout.Stats
    if not st then state = nil return end
    local g = function(name) return lp:GetAttribute(name) end
    if g("YV_InfGas") then st.ODM_Gas = st.Maximum_ODM_Gas or st.ODM_Gas end
    local sp = g("YV_Speed") or 1
    tweak(st, "ODM_Speed", sp > 1, function(b) return b * sp end)
    tweak(st, "ODM_Control", g("YV_Control"), function(b) return b * 3 end)
    tweak(st, "ODM_Range", g("YV_Range"), function(b) return b * 5 end)
    tweak(st, "Boost_Dashes", g("YV_InfBoost"), function() return 99 end)
    local mods = state.Modules
    if mods then
        -- no cooldown between boost dashes
        if g("YV_NoBoostCD") and mods.ODMG and mods.ODMG.Last_Flip then mods.ODMG.Last_Flip.Cooldown = false end
        -- no cooldown on climbing
        if g("YV_NoClimbCD") and mods.Climb then mods.Climb.Cooldown = false end
        -- hook keys can be pressed again straight away (the game waits 0.3s between presses of the same key)
        if g("YV_NoHookCD") and mods.Input and mods.Input.Actions then
            for _, act in pairs(mods.Input.Actions) do
                if type(act) == "table" and type(act.Action) == "string" and act.Action:find("Hook") then act.Last = 0 end
            end
        end
    end
end)
]==]
local odmSupported = run_on_actor ~= nil and getactors ~= nil
local odmChar, odmAt
local function installODM()
    if not odmSupported then return false end
    -- one install per character (restoring several saved ODM toggles at startup must not install it several times)
    if odmChar == lp.Character and odmAt and tick() - odmAt < 30 then return true end
    local mine
    for _, a in ipairs(getactors()) do
        if lp.Character and a:IsDescendantOf(lp.Character) then mine = a end
    end
    if not mine then return false end
    odmChar, odmAt = lp.Character, tick()
    return (pcall(run_on_actor, mine, ODM_CODE))
end
local function odmAttr(name, value) lp:SetAttribute(name, value) end
local function odmActive()
    return S.OdmInfGas or S.OdmSpeed > 1 or S.OdmControl or S.OdmRange or S.OdmNoBoostCD or S.OdmInfBoost or S.OdmNoClimbCD or S.OdmNoHookCD
end

