-- ===== hit sound: a clip (your Tatakae / "Fight!") plays on every hit =====
-- Source = a Roblox audio id (digits / rbxassetid://...) or a direct link to an .mp3 / .ogg / .wav file. A link is downloaded
-- once into the executor workspace and played from there. A new hit never cuts the clip off, and at most one sound
-- starts per "gap", so a fast farm does not stack them.
local sKill = Home:Section({ Name = "Hit sound", Icon = "zap", Side = 2 })
sKill:Label({ Name = "Plays a sound (bonk!) on every hit" })
-- default sound: the TF2 bonk (public Roblox audio id, plays for everyone). Typing your own audio id / .mp3 link / workspace file in
-- the box replaces it; clearing the box brings it back.
local DEFAULT_HIT_SOUND = "124963990860864"
local killSrc, killAsset, killSound, killLast = "", nil, nil, 0
task.spawn(function() -- load it up front so the very first hit is not silent while it downloads
    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = "rbxassetid://" .. DEFAULT_HIT_SOUND
        game:GetService("ContentProvider"):PreloadAsync({ snd })
        snd:Destroy()
    end)
end)
local function resolveKillAsset()
    local src = tostring(killSrc or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if src == "" then src = DEFAULT_HIT_SOUND end
    if killAsset and killAsset.src == src then return killAsset.id end
    local id
    local digits = src:match("^rbxassetid://(%d+)$") or src:match("^(%d+)$")
    if digits then
        id = "rbxassetid://" .. digits
    elseif src:match("^rbxasset://") then
        id = src
    elseif isfile and getcustomasset and not src:match("^https?://") and isfile(src) then
        -- a sound file inside the executor workspace, e.g. YvesHub/mysound.mp3
        local ok = pcall(function() id = getcustomasset(src) end)
        if not ok then id = nil end
    elseif src:match("^https?://") and writefile and getcustomasset then
        local ext = (src:match("%.(%w+)[%?#]?[^/]*$") or "mp3"):lower()
        if ext ~= "mp3" and ext ~= "ogg" and ext ~= "wav" then ext = "mp3" end
        local ok = pcall(function()
            if makefolder and isfolder and not isfolder("YvesHub") then makefolder("YvesHub") end
            local path = "YvesHub/hit_sound." .. ext
            writefile(path, game:HttpGet(src))
            id = getcustomasset(path)
        end)
        if not ok then id = nil end
    end
    killAsset = { src = src, id = id }
    return id
end
local function playKillSound(force)
    if not force and (tick() - killLast < (tonumber(S.HitSoundGap) or 0.3) or (killSound and killSound.IsPlaying)) then return end
    local id = resolveKillAsset()
    if not id then
        if force then pcall(function() Library:Notification({ Name = "Hit sound: could not load that sound (check the audio id / link)", Time = 5 }) end) end
        return
    end
    killLast = tick()
    pcall(function()
        if not killSound or not killSound.Parent then
            killSound = Instance.new("Sound")
            killSound.Name = "YvesHitSound"
            killSound.Parent = game:GetService("SoundService")
        end
        killSound.SoundId = id
        killSound.Volume = tonumber(S.HitSoundVol) or 5
        killSound.TimePosition = 0
        killSound:Play()
    end)
end
