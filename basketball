local function watchTitan(t)
    local hum = t:FindFirstChildOfClass("Humanoid") or t:WaitForChild("Humanoid", 5)
    if not hum then return end
    local function check() if titanDown(t) then markSlain(t) end end
    hum.HealthChanged:Connect(check)
    t.ChildRemoved:Connect(function(c) if c.Name == "Humanoid" then check() end end)
    t:GetAttributeChangedSignal("State"):Connect(check)
    t.AncestryChanged:Connect(check)
    local hit = hitFolder(t)
    if hit then hit.ChildRemoved:Connect(check) end
end
