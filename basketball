-- The game's own remotes: Assets.Remotes.POST (FireServer) and .GET (InvokeServer), both called as (Module, Action, ...)
local remotes
local function getRemotes()
    if remotes then return remotes end
    local a = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
    local r = a and a:FindFirstChild("Remotes")
    if r and r:FindFirstChild("POST") and r:FindFirstChild("GET") then remotes = { post = r.POST, get = r.GET } end
    return remotes
end
local function send(...)
    local r = getRemotes()
    if r then r.post:FireServer(...) end
end
local function invoke(...)
    local r = getRemotes()
    if not r then return nil end
    local args = table.pack(...)
    local ok, res = pcall(function() return r.get:InvokeServer(table.unpack(args, 1, args.n)) end)
    return ok and res or nil
end
-- One hit on a titan's neck: slash state on, then register the hit (what the game's own client sends).
-- Captured from the game's own client (Cobalt): POST:FireServer("Hitboxes", "Register", <hitbox part>, <0.11-0.19 float>)
-- No GET invoke and no slash-state call. S.LegacyHit switches back to the old invoke format.
local function registerHit(part)
    if S.HitSound and hitSoundHook then task.spawn(hitSoundHook) end
    if S.LegacyHit then
        send("Attacks", "Slash", true)
        invoke("Hitboxes", "Register", part, math.random(215, 230), math.random(10, 100))
    else
        send("Hitboxes", "Register", part, math.random(110, 190) / 1000)
    end
end
