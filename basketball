local function titanFolder() return workspace:FindFirstChild("Titans") end
local function titans()
    local f, out = titanFolder(), {}
    if f then for _, t in ipairs(f:GetChildren()) do if t:IsA("Model") then out[#out+1] = t end end end
    -- the Female Titan (Annie) lives directly in workspace in her raid, not in the Titans folder
    if f then
        for _, t in ipairs(workspace:GetChildren()) do
            if t:IsA("Model") and t ~= f and t:GetAttribute("Shifter") == true and t:FindFirstChild("Hitboxes") then out[#out+1] = t end
        end
    end
    return out
end
local function root(t) return t:FindFirstChild("HumanoidRootPart") or t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart", true) end
local function hitFolder(t)
    local hb = t:FindFirstChild("Hitboxes")
    return hb and hb:FindFirstChild("Hit")
end
local PART_MAP = {
    Nape = { "Nape" }, Eyes = { "Eyes" },
    Arms = { "LeftArm", "RightArm" }, Legs = { "LeftLeg", "RightLeg" },
}
local function hitParts(t)
    local hit = hitFolder(t)
    if not hit then return {} end
    local r = {}
    if S.HitboxPart == "Any part" then
        for _, p in ipairs(hit:GetChildren()) do if p:IsA("BasePart") then r[#r+1] = p end end
    else
        for _, n in ipairs(PART_MAP[S.HitboxPart] or {}) do
            local p = hit:FindFirstChild(n)
            if p then r[#r+1] = p end
        end
    end
    return r
end
-- top of the titan's head (visual model, so the expanded hitboxes do not inflate it) and the head position
local function headTop(t)
    local fake = t:FindFirstChild("Fake")
    local head = fake and fake:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.Position.Y + head.Size.Y / 2, head.Position
    end
    local r = root(t)
    return r.Position.Y + 20, r.Position
end
local function napeOf(t)
    local hit = hitFolder(t)
    return (hit and hit:FindFirstChild("Nape")) or root(t)
end
-- Kill checker: true the moment ANY death signal shows up, so we never wait for the model to disappear.
local DEAD_WORDS = { "dead", "death", "dying", "die", "slain", "killed", "fall", "limp" }
local function titanDown(t)
    if not t.Parent then return true end
    local hum = t:FindFirstChildOfClass("Humanoid")
    -- the game removes a titan's Humanoid the instant it dies; the body lingers ~6s more (verified live)
    if not hum then return true end
    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    local st = t:GetAttribute("State")
    if type(st) == "string" then
        st = st:lower()
        for _, w in ipairs(DEAD_WORDS) do if st:find(w, 1, true) then return true end end
    end
    local hit = hitFolder(t)
    if not hit or not hit:FindFirstChild("Nape") then return true end
    return false
end
local isDead = titanDown

