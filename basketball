-- AutoKill / Auto start are applied last so everything else is configured before they begin
local LATE = { AutoKill = true, FarKill = true, m_auto = true, c_auto = true, g_auto = true, a_auto = true }
local function snapshot()
    local data = {}
    for _, k in ipairs(FLAGS) do
        local v = Library.Flags[k]
        if type(v) == "table" and typeof(v.Color) == "Color3" then data[k] = "#" .. v.Color:ToHex() -- colour pickers are saved as hex
        elseif v ~= nil and type(v) ~= "userdata" then data[k] = v end
    end
    return data
end
local lastSaved
local function saveConfig()
    local data = snapshot()
    -- never overwrite the saved settings with an empty snapshot (an empty table encodes as "[]" and would wipe everything)
    if next(data) == nil then return end
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and json ~= lastSaved and writefile then
        pcall(function()
            if makefolder and isfolder and not isfolder("YvesHub") then makefolder("YvesHub") end
            writefile(CONFIG_FILE, json)
        end)
        lastSaved = json
    end
end
do
    local ok, saved = pcall(function()
        if isfile and isfile(CONFIG_FILE) then return HttpService:JSONDecode(readfile(CONFIG_FILE)) end
    end)
    if ok and type(saved) == "table" then
        for pass = 1, 2 do
            for _, k in ipairs(FLAGS) do
                if (LATE[k] == true) == (pass == 2) and saved[k] ~= nil and Library.SetFlags[k] then
                    pcall(Library.SetFlags[k], saved[k])
                    task.wait()
                end
            end
        end
    end
    lastSaved = nil
end
