local SOURCE_URL = "https://raw.githubusercontent.com/felixtypesoul-beep/yves/refs/heads/main/basketball"
local Library = (function()
    -- same UI build as the basketball (Learn PB) hub. The two link forms (.../refs/heads/main/... and .../main/...) are cached separately and
    -- either can still hold the previous upload, so both are downloaded and the NEWEST copy wins (higher Library.Build, then the logo build)
    local body, res, bestScore
    local SHORT_URL = SOURCE_URL:gsub("/refs/heads/", "/")
    for _, url in ipairs({ SOURCE_URL .. "?v=" .. os.time(), SHORT_URL .. "?v=" .. os.time() }) do
        local ok, r = pcall(function() return game:HttpGet(url) end)
        if ok and type(r) == "string" and #r > 1000 and r:find("Library.Build", 1, true) then -- (a wrong file uploaded under that name is skipped)
            local score = (r:match('Library%.Build = "([^"]+)"') or "") .. "|" .. (r:find("LogoAspect = 96 / 24", 1, true) and "1" or "0")
            if not bestScore or score > bestScore then body, bestScore = r, score end
        else
            res = r
        end
    end
    if not body then -- last resort: the older UI build
        local ok, r = pcall(function() return game:HttpGet(SOURCE_URL:gsub("/main/basketball$", "/main/source")) end)
        if ok and type(r) == "string" and #r > 1000 and r:find("Library.Build", 1, true) then body = r else res = r end
    end
    if not body then error("Yves UI download failed: " .. tostring(res)) end
    -- older copies crash in Slider:Set when Decimals is a step like 0.01 (no-op once the source line is fixed)
    local bad = 'string.format("%." .. Slider.Decimals .. "f", Slider.Value)'
    local good = 'string.format("%." .. (Slider.Decimals >= 1 and Slider.Decimals or math.max(0, math.ceil(-math.log10(Slider.Decimals)))) .. "f", Slider.Value)'
    local a, b = body:find(bad, 1, true)
    if a then body = body:sub(1, a - 1) .. good .. body:sub(b + 1) end
    -- Toggle Color: a separate theme color for the toggles (Settings > Theming). Applied here when the GitHub copy of the UI does not have it yet.
    if not body:find('"Toggle Color"', 1, true) then
        local function swap(x, y) local i, j = body:find(x, 1, true) if i then body = body:sub(1, i - 1) .. y .. body:sub(j + 1) end end
        swap('["Accent"] = Color3.fromRGB(255, 23, 68),', '["Accent"] = Color3.fromRGB(255, 23, 68), ["Toggle Color"] = Color3.fromRGB(255, 23, 68),')
        local ta = body:find("Library.Toggle = function(Self, Params)", 1, true)
        local tb = ta and body:find("function Toggle:SetVisibility", ta, true)
        if ta and tb then
            local seg = body:sub(ta, tb - 1):gsub('Library%.Theme%["Accent"%]', 'Library.Theme["Toggle Color"]'):gsub("'Accent'", "'Toggle Color'")
            body = body:sub(1, ta - 1) .. seg .. body:sub(tb)
        end
    end
    -- toggles that are already ON follow Toggle Color live (older UI copies only recolored a toggle when it was clicked)
    if not body:find("follows Toggle Color live", 1, true) then
        local sa = body:find("function Toggle:Set(Bool)", 1, true)
        if sa then
            local onTw = 'Items["Indicator"]:Tween({BackgroundColor3 = Library.Theme["Toggle Color"]})'
            local offTw = 'Items["Indicator"]:Tween({BackgroundColor3 = Library.Theme["Slider Track"]})'
            local i, j = body:find(onTw, sa, true)
            if i then
                body = body:sub(1, j) .. ' Items["Indicator"]:ChangeItemTheme({BackgroundColor3 = function() return Library.Theme["Toggle Color"] end}) -- follows Toggle Color live' .. body:sub(j + 1)
                local i2, j2 = body:find(offTw, j, true)
                if i2 then body = body:sub(1, j2) .. ' Items["Indicator"]:ChangeItemTheme({BackgroundColor3 = "Slider Track"})' .. body:sub(j2 + 1) end
            end
        end
    end
    -- checkbox outlines: pointy (miter) corners become smooth rounded ones
    body = body:gsub('(Parent = Items%["Indicator"%]%.Instance,%s*ApplyStrokeMode = Enum%.ApplyStrokeMode%.Border,%s*LineJoinMode = Enum%.LineJoinMode%.)Miter,', '%1Round,')
    local fn, err = loadstring(body)
    if not fn then error("Yves UI compile failed: " .. tostring(err)) end
    local lib = fn()
    pcall(function()
        lib.Theme["Toggle Color"] = lib.Theme["Toggle Color"] or lib.Theme["Accent"]
        for _, P in pairs(lib.Presets or {}) do if not P["Toggle Color"] then P["Toggle Color"] = P["Accent"] end end
    end)
    return lib
end)()

