-- Paste a Discord webhook link in the Auto Farm tab (farm reports) and / or the Auto tab (family rolls).
local Hook = { farmUrl = "", famUrl = "", q = {}, running = true, hist = {}, recent = {} }
Hook.req = (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
Hook.rarity = { Common = 0x9AA0A6, Uncommon = 0x57F287, Rare = 0x3B82F6, Epic = 0xA855F7, Legendary = 0xFFC428, Mythical = 0xFF4D4D }
function Hook.valid(u)
    if type(u) ~= "string" then return false end
    for _, host in ipairs({ "discord%.com", "discordapp%.com", "ptb%.discord%.com", "canary%.discord%.com" }) do
        if u:match("^https://" .. host .. "/api/webhooks/%d+/[%w_%-]+") then return true end
    end
    return false
end
function Hook.note(text) pcall(function() Library:Notification({ Name = tostring(text), Time = 4 }) end) end
function Hook.avatar() return ("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png"):format(lp.UserId) end
function Hook.footer() return { text = "Yves Hub  •  Aotr  •  " .. os.date("%H:%M") } end
function Hook.stamp() return os.date("!%Y-%m-%dT%H:%M:%SZ") end
function Hook.bar(f, len)
    local n = math.floor(math.clamp(f, 0, 1) * len + 0.5)
    return string.rep("▰", n) .. string.rep("▱", len - n)
end
function Hook.dur(sec)
    sec = math.floor(sec)
    return ("%dh %02dm %02ds"):format(sec // 3600, (sec % 3600) // 60, sec % 60)
end
function Hook.post(url, payload)
    if not Hook.req then Hook.note("Webhook: this executor has no http request function") return false end
    if not Hook.valid(url) then Hook.note("Webhook: paste a valid Discord webhook link") return false end
    local ok, res = pcall(Hook.req, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(payload) })
    local code = ok and type(res) == "table" and (res.StatusCode or res.status_code) or nil
    return (code ~= nil and code >= 200 and code < 300), code
end
function Hook.enqueue(url, payload) table.insert(Hook.q, { url = url, payload = payload }) end
task.spawn(function() -- one message every ~1.4s so Discord never rate-limits a fast spin
    while Hook.running do
        local item = table.remove(Hook.q, 1)
        if item then pcall(Hook.post, item.url, item.payload); task.wait(1.4) else task.wait(0.5) end
    end
end)
