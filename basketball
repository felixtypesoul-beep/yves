-- noclip while farming, so hovering at the titan never snags on its body (restored when farming stops)
local noclipParts = setmetatable({}, { __mode = "k" })
conns[#conns+1] = RunService.Stepped:Connect(function()
    local ch = lp.Character
    if Boot.raidFarmOn and not refilling and ch then -- auto titan farm no longer uses noclip (raid farm still does)
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then noclipParts[p] = true; p.CanCollide = false end
        end
    elseif next(noclipParts) ~= nil then
        for p in pairs(noclipParts) do
            if p.Parent then p.CanCollide = true end
            noclipParts[p] = nil
        end
    end
end)

local acc, frames = 0, 0
-- grab / bite minigame needs fast reactions, so it runs every frame instead of in the 0.25s loop
conns[#conns+1] = RunService.Heartbeat:Connect(function()
    if S.AutoEscape then escapeStep() end
end)

conns[#conns+1] = RunService.Heartbeat:Connect(function(dt)
    frames += 1
    acc += dt
    if acc < 0.25 then return end
    local fps = math.floor(frames / acc + 0.5)
    frames = 0; acc = 0

    do -- NaN guard: a broken (NaN) character position means the player can never move again, so put it back
        local hrpG = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrpG then
            local pg = hrpG.Position
            if pg.X ~= pg.X or pg.Y ~= pg.Y or pg.Z ~= pg.Z then
                local bvG = hrpG:FindFirstChild("BV")
                if bvG and bvG:IsA("BodyVelocity") then bvG.Velocity = Vector3.zero; bvG.MaxForce = Vector3.zero end
                hrpG.AssemblyLinearVelocity = Vector3.zero
                hrpG.AssemblyAngularVelocity = Vector3.zero
                if stats.lastGood then hrpG.CFrame = stats.lastGood end
            else
                stats.lastGood = hrpG.CFrame
            end
        end
    end
    if S.AutoKill or S.LegitFarm or Boot.raidFarmOn then -- the farm owns the neck hitboxes while it runs (invisible)
    elseif S.Hitbox then applyHitbox()
    elseif next(original) ~= nil and not S.AutoFarm2 and not S.FarKill then restoreHitbox() end
    if S.AutoReload or S.AutoRefill then refillStep() end
    if S.AutoChests or S.AutoSkip then roundsStep() end
    if S.AutoRetry then retryStep() end
    if not busy and stats.state == "Refilling" then stats.state = S.AutoKill and "Killing" or "Idle" end

    local gas = readGas()
    local cur, max = readBlades()
    local up = math.floor(tick() - stats.started)
    lPlace:SetText(("place %d, %d in server"):format(game.PlaceId, #Players:GetPlayers()))
    lUp:SetText(("uptime: %dm %ds"):format(up // 60, up % 60))
    lFps:SetText("fps: " .. fps)
    lSlain:SetText(("Titans slain: %d"):format(stats.slain))
    lState:SetText("State: " .. stats.state)
    lGas:SetText("Gas: " .. (gas and (gas .. "%") or "?"))
    lBlade:SetText("Blade sets: " .. (cur and (cur .. " / " .. max) or "?"))
    lCur:SetText("Current family: " .. tostring(currentFamily() or "?"))
    lLeft:SetText("Spins left: " .. tostring((spinsLeft()) or "?"))
    lRolls:SetText("Rolled this session: " .. A.Rolls)
    lChests:SetText(("Chests opened: %d"):format(stats.chests))
    if FarmLabels.state then
        FarmLabels.state:SetText("State: " .. stats.state)
        FarmLabels.slain:SetText(("Titans slain: %d"):format(stats.slain))
        FarmLabels.level:SetText(progress.level and ("Level: %d  (%s)"):format(progress.level, progress.G("+" .. (progress.level - (progress.level0 or progress.level)) .. " gained")) or "Level: ?")
        if FarmLabels.levelTL then FarmLabels.levelTL.TextColor3 = FarmLabels.gold_color end
        if FarmLabels.goldTL then FarmLabels.goldTL.TextColor3 = FarmLabels.gold_color end
        FarmLabels.gold:SetText(progress.gold and ("Gold: %s  (total %s)"):format(progress.G("+" .. progress.fmt(progress.gold - (progress.gold0 or progress.gold)) .. " gained"), progress.fmt(progress.gold)) or "Gold: ?")
    end
end)

