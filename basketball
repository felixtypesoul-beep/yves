local safeCache = { at = 0, x = 24, y = 300 }
local function safePoint()
    if tick() - safeCache.at < 2 then return safeCache.x, safeCache.y end
    safeCache.at = tick()
    local vp = workspace.CurrentCamera.ViewportSize
    local rects = {}
    local g = hubGui()
    if g then
        local inset = g.IgnoreGuiInset and 0 or game:GetService("GuiService"):GetGuiInset().Y
        for _, d in ipairs(g:GetDescendants()) do
            if d:IsA("Frame") and d.Visible and d.AbsoluteSize.X >= 250 and d.AbsoluteSize.Y >= 150 then
                local p, s = d.AbsolutePosition, d.AbsoluteSize
                rects[#rects+1] = { p.X - 16, p.Y + inset - 16, p.X + s.X + 16, p.Y + inset + s.Y + 16 }
            end
        end
    end
    local cands = {
        { 24, vp.Y * 0.5 }, { vp.X - 24, vp.Y * 0.5 }, { 24, vp.Y * 0.3 }, { vp.X - 24, vp.Y * 0.3 },
        { vp.X * 0.5, vp.Y - 24 }, { vp.X * 0.5, 24 }, { 24, vp.Y * 0.7 }, { vp.X - 24, vp.Y * 0.7 },
    }
    for _, c in ipairs(cands) do
        local covered = false
        for _, r in ipairs(rects) do
            if c[1] >= r[1] and c[1] <= r[3] and c[2] >= r[2] and c[2] <= r[4] then covered = true break end
        end
        if not covered then safeCache.x, safeCache.y = c[1], c[2] return c[1], c[2] end
    end
    safeCache.x, safeCache.y = cands[1][1], cands[1][2]
    return safeCache.x, safeCache.y
end
local clickPt
local function mouseDown()
    local x, y = safePoint()
    clickPt = { x, y }
    Boot.synthUntil = tick() + 0.25 -- not the player's click
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
end
local function mouseUp()
    local p = clickPt or { safeCache.x, safeCache.y }
    Boot.synthUntil = tick() + 0.25
    VIM:SendMouseButtonEvent(p[1], p[2], 0, false, game, 0)
end
local function farmOn() return S.AutoKill or Boot.raidFarmOn == true end
-- registers the hit on every stacked nape. Normal titans get the old single register; Eren's nape gets S.ErenHits registers
-- sent in the same instant with the same swing value (no waiting between them). Same for the other shifter bosses (Female etc).
-- true while a cutscene / intro is playing (the game shows its SKIP button): nothing is swung or registered then
local function inCutscene()
    local i = iface()
    local sk = i and i:FindFirstChild("Skip")
    return sk ~= nil and isShown(sk)
end
-- Boss scream / roar (Eren, Armored...): while it plays the boss takes no damage and every hit only wears our blades down
-- (measured on the Armored Titan: a 7.9s animation, boss bar flat or regenerating until it ends). Any long (>= 5s),
-- non-looping animation on the boss's animator counts, so nothing is swung or registered at him until it is over.
local function bossScreaming(t)
    if not t or not t.Parent then return false end
    local f = t:FindFirstChild("Fake")
    local ctl = f and f:FindFirstChild("Controller")
    local an = ctl and ctl:FindFirstChildOfClass("Animator")
    if not an then return false end
    for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
        if tr.Length >= 5 and not tr.Looped and tr.IsPlaying then return true end
    end
    return false
end
-- boss bar tracking: bossHitSince = when we started really hitting the boss with the bar text unchanged (a shielded gate)
local bossLast, bossSince, bossProbeAt, bossHitSince = nil, tick(), 0, nil
local function registerAll(live, hold)
    local count = math.clamp(tonumber(S.ErenHits) or 30, 1, 40)
    if S.HitSound and hitSoundHook and #live > 0 then task.spawn(hitSoundHook) end -- one sound per swing, not per titan
    for _, n in ipairs(live) do
        if n.Parent then
            local tt = n.Parent.Parent and n.Parent.Parent.Parent
            local boss = tt and (tt.Name == "Attack_Titan" or tt:GetAttribute("Shifter") == true) -- Eren, Female, any shifter boss
            if boss and bossScreaming(tt) then continue end
            if boss and not bossHitSince then bossHitSince = tick() end
            local times = boss and count or 1
            for _ = 1, times do send("Hitboxes", "Register", n, hold) end
        end
    end
end
-- ===== legit farm: up and down dives on a nape hitbox held above the titan =====
-- Same trick as the normal titan farm (the neck is unwelded and anchored, which is what makes the game accept the hit), but
-- one titan at a time and with the speed from the Legit farm section: the target's nape hitbox is stretched (slider) and
-- held above the titan's head, the character rises above the top of the box, dives into its top edge at the set speed,
-- swings and registers the hit there, then rises again. It never goes down to the nape itself.
local legitRunning = false
local legitNoclip
local legitSkip = setmetatable({}, { __mode = "k" })
function legitLoop()
    if legitRunning then return end
    legitRunning = true
    task.spawn(function()
        -- Noclip only while the legit farm is really flying. During a refill trip / blade swap / when switched off the collisions
        -- are handed back, otherwise the character fell through the floor and stayed stuck underground.
        local legitParts = setmetatable({}, { __mode = "k" })
        local function legitSolid()
            for p in pairs(legitParts) do
                if p.Parent then p.CanCollide = true end
                legitParts[p] = nil
            end
        end
        Boot.legitSolid = legitSolid -- the refill trip calls this to hand the collisions back before it teleports
        legitNoclip = RunService.Stepped:Connect(function()
            local ch = lp.Character
            if not ch then return end
            if not S.LegitNoclip or busy or refilling or reloadPause then legitSolid() return end
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then legitParts[p] = true; p.CanCollide = false end
            end
        end)
        local function bigNape(nape, t)
            local sz = math.clamp(tonumber(S.LegitHitbox) or 60, 20, 400)
            stackAdopt(nape)
            nape.Size = Vector3.new(sz, sz, sz)
            nape.Transparency = 1 -- never shown while the legit farm runs
            nape.CanCollide = false
            nape.CanTouch = true
            -- held above the head (the visual model, so the stretched box does not move it)
            local topY, headPos = headTop(t)
            nape.CFrame = CFrame.new(headPos.X, topY + sz / 2 + 10, headPos.Z)
        end
        local function speed() return math.clamp(tonumber(S.LegitSpeed) or 300, 30, 2000) end
        -- one step of flight towards a point, returns the distance left
        local function flyStep(hrp, goal)
            local d = goal - hrp.Position
            if d.Magnitude > 2 then
                driveVelocity(hrp, d.Unit * math.min(speed(), d.Magnitude * 8 + 10))
            else
                driveVelocity(hrp, Vector3.zero)
            end
            return d.Magnitude
        end
        while S.LegitFarm do
            local ok, err = pcall(function()
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then task.wait(0.3) return end
                if S.AutoKill or Boot.raidFarmOn == true then task.wait(0.3) return end
                pcall(guardVoid, hrp) -- under the map with nothing below: back up to the last ground that was seen
                if busy or refilling then stopFlying(hrp) task.wait(0.2) return end
                if reloadPause then driveVelocity(hrp, Vector3.zero) task.wait(0.1) return end -- hold in place instead of dropping
                if inCutscene and inCutscene() then stats.state = "Cutscene" task.wait(0.2) return end
                if not titanFolder() then stats.state = "Waiting for titans" stopFlying(hrp) task.wait(0.5) return end
                -- every live neck gets the big hitbox; the nearest titan (not skipped) is the target
                local best, bestNape, bd
                for _, t in ipairs(titans()) do
                    if not titanDown(t) then
                        local hit = hitFolder(t)
                        local nape = hit and hit:FindFirstChild("Nape")
                        -- no hitbox is shown while the legit farm runs (also the ones the Expand hitbox option made visible)
                        if hit then
                            for _, hp in ipairs(hit:GetChildren()) do
                                if hp:IsA("BasePart") and hp.Transparency < 1 then remember(hp) hp.Transparency = 1 end
                            end
                        end
                        if nape and nape:IsA("BasePart") then
                            if (legitSkip[t] or 0) < tick() then
                                local d = (nape.Position - hrp.Position).Magnitude
                                if not bd or d < bd then best, bestNape, bd = t, nape, d end
                            end
                        end
                    end
                end
                if not best then stats.state = "Waiting for titans" stopFlying(hrp) task.wait(0.5) return end
                stats.state = "Legit farm"
                local t0 = tick()
                local hold = math.max(tonumber(S.SwingHold) or 0.1, 0.05)
                while S.LegitFarm and not titanDown(best) and bestNape.Parent and hrp.Parent and not busy and not reloadPause and not S.AutoKill do
                    bigNape(bestNape, best)
                    local half = bestNape.Size.X / 2
                    local rise = math.max(tonumber(S.LegitHover) or 40, 10)
                    -- 1) up: over the titan, above the top of the box
                    while S.LegitFarm and not titanDown(best) and bestNape.Parent do
                        bigNape(bestNape, best)
                        local p = bestNape.Position
                        if flyStep(hrp, Vector3.new(p.X, p.Y + half + rise, p.Z)) <= 4 then break end
                        if tick() - t0 > 8 then break end
                        RunService.Heartbeat:Wait()
                    end
                    -- 2) down: dive into the top edge of the box, swing so it is released just inside, register the hit
                    local down, hitDone = false, false
                    while S.LegitFarm and not titanDown(best) and bestNape.Parent and not hitDone do
                        bigNape(bestNape, best)
                        local p = bestNape.Position
                        local topY = p.Y + half
                        local goal = Vector3.new(p.X, topY - 10, p.Z)
                        local left = flyStep(hrp, goal)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, -speed(), 0) -- the game scales damage with your speed, so the dive must have real velocity
                        if not down and left <= speed() * hold + 6 and not (inCutscene and inCutscene()) then down = true mouseDown() end
                        if hrp.Position.Y <= topY - 4 then
                            hitDone = true
                            mouseUp()
                            if bestNape.Parent and not titanDown(best) then hitNape(bestNape) end
                        end
                        if tick() - t0 > 8 then break end
                        RunService.Heartbeat:Wait()
                    end
                    if down and not hitDone then mouseUp() end
                    if tick() - t0 > 8 then legitSkip[best] = tick() + 10 break end
                end
                stopFlying(hrp)
                stackRelease()
            end)
            if not ok then
                stats.state = "Error: " .. tostring(err):sub(1, 40)
                task.wait(1)
            end
            task.wait()
        end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then stopFlying(hrp) end
        if legitNoclip then legitNoclip:Disconnect() legitNoclip = nil end
        legitSolid()
        stackRelease()
        restoreHitbox()
        if not S.AutoKill then stats.state = "Idle" end
        legitRunning = false
    end)
end
-- ===== register hit on swing =====
-- The moment you click to swing, the hit is registered straight away on the titan you are aiming at (nearest to the
-- crosshair inside the range), so the hit has the same timestamp as the swing. Clicks the farms simulate are ignored.
do
    local UIS = game:GetService("UserInputService")
    conns[#conns+1] = UIS.InputBegan:Connect(function(i)
        if not S.SwingHit then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
        if tick() < (Boot.synthUntil or 0) then return end -- a farm's own click
        if UIS:GetFocusedTextBox() then return end
        local cam = workspace.CurrentCamera
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not cam or not hrp or not titanFolder() then return end
        local range = tonumber(S.SwingRange) or 300
        local look = cam.CFrame.LookVector
        local best, bestAng
        for _, t in ipairs(titans()) do
            if not titanDown(t) then
                local hit = hitFolder(t)
                local nape = hit and hit:FindFirstChild("Nape")
                if nape and nape:IsA("BasePart") then
                    local v = nape.Position - cam.CFrame.Position
                    local dist = (nape.Position - hrp.Position).Magnitude
                    if dist <= range and v.Magnitude > 0 then
                        local ang = math.deg(math.acos(math.clamp(look:Dot(v.Unit), -1, 1)))
                        -- big titans are aimed at by their body, so allow a wider cone for close ones
                        local cone = dist < 60 and 70 or 40
                        if ang <= cone and (not bestAng or ang < bestAng) then best, bestAng = nape, ang end
                    end
                end
            end
        end
        if best then task.spawn(registerHit, best) end
    end)
end
local killing = false
-- raid boss health bar (percent), nil when there is no raid bar on screen
local function bossBarPct()
    local i = iface()
    local p = i and i:FindFirstChild("Raids")
    p = p and isShown(p) and p:FindFirstChild("Health")
    p = p and p:FindFirstChild("Outer") and p.Outer:FindFirstChild("Backing") and p.Outer.Backing:FindFirstChild("Percentage")
    -- the text looks like "100.0% [74.6%]" (boss health + current segment): returns the health and the whole text
    return p and tonumber(p.Text:match("[%d%.]+")), p and p.Text
end
function killLoop()
    if killing then return end
    killing = true
    task.spawn(function()
        local STACK, RISE, SPEED = 160, 150, S.DiveSpeed or 500
        local function myHrp() return lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") end
        local start = myHrp()
        while farmOn() and not start do task.wait(0.3); start = myHrp() end
        if not farmOn() then killing = false return end
        -- on toggle: go up to a fixed hover height (titans cannot reach it); the stacked hitbox sits right there, each pass
        -- goes up, dives through the box with the swing and comes back to rest at the hover height
        local P = start.Position
        do
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { lp.Character, workspace:FindFirstChild("Titans") }
            local res = workspace:Raycast(start.Position, Vector3.new(0, -4000, 0), rp)
            local ground = res and res.Position.Y or (start.Position.Y - 100)
            P = Vector3.new(start.Position.X, math.max(start.Position.Y, ground + math.max(tonumber(S.HoverHeight) or 120, 20)), start.Position.Z)
        end
        local want, wantVel = CFrame.new(P), Vector3.zero
        local drive = RunService.Heartbeat:Connect(function()
            local cf = CFrame.new(P)
            for n in pairs(stackSaved) do if n.Parent then n.CFrame = cf end end
            local hrp = myHrp()
            -- holds the character exactly where the farm wants it (noclip is on, so it must never be left to fall)
            if hrp and want and not busy then
                hrp.CFrame = want
                hrp.AssemblyLinearVelocity = wantVel
            end
        end)
        local function glide(toPos, speed)
            local hrp = myHrp()
            if not hrp then return end
            local from = hrp.Position
            local d = toPos - from
            if d.Magnitude < 1 then want = CFrame.new(toPos) return end
            local dir, dur = d.Unit, d.Magnitude / speed
            wantVel = dir * speed
            local t0 = tick()
            while farmOn() and not busy do
                local el = tick() - t0
                if el >= dur then break end
                want = CFrame.new(from + dir * (speed * el))
                RunService.Heartbeat:Wait()
            end
            want = CFrame.new(toPos)
            wantVel = Vector3.zero
        end
        while farmOn() do
            -- every pass is protected: an error can no longer kill the farm
            local ok, err = pcall(function()
                if busy then task.wait(0.3) return end
                if reloadPause then task.wait(0.1) return end
                if inCutscene() then stats.state = "Cutscene" task.wait(0.1) return end
                if not titanFolder() then
                    stats.state = "Waiting for titans"
                    task.wait(0.5)
                    return
                end
                -- every live neck is stacked on the spot, size and transparency refreshed each pass
                local live, bosses = {}, {}
                for _, t in ipairs(titans()) do
                    if not titanDown(t) then
                        local hit = hitFolder(t)
                        local nape = hit and hit:FindFirstChild("Nape")
                        if nape and nape:IsA("BasePart") then
                            stackAdopt(nape)
                            nape.Size = Vector3.new(STACK, STACK, STACK)
                            nape.Transparency = 1
                            nape.CanTouch = true
                            if t:GetAttribute("Shifter") == true or t.Name:find("Armored", 1, true) then
                                -- a screaming / roaring boss takes no damage: leave him out until it is over
                                if not bossScreaming(t) then bosses[#bosses+1] = nape end
                            else
                                live[#live+1] = nape
                            end
                        end
                    end
                end
                -- Armored Titan raid: every other titan has to die first, only then is the Armored Titan hit.
                -- (every other raid hits the bosses together with everything else)
                local objective = workspace:GetAttribute("Objective")
                local armoredFirst = type(objective) == "string" and objective:find("Armored", 1, true) ~= nil
                -- raid boss bar stuck (not dropping although we hit): titans are still spawning and shield him. Kill every
                -- remaining / newly spawned titan first, and only go for the boss when none are left (any raid, not just Armored)
                do
                    local pct, txt = bossBarPct()
                    if txt ~= bossLast then bossLast, bossSince, bossHitSince = txt, tick(), nil end
                    -- only counts once the boss has really been hit for 6s without the bar moving
                    if pct and pct > 0.5 and bossHitSince and tick() - bossHitSince > 6 then
                        armoredFirst = true
                        -- the boss is shielded at the gates (75% / 50% / 25%) while waves keep spawning: hitting him only wears the
                        -- blades. Leave him alone and kill titans; one probe dive every 12s notices when the shield is gone.
                        if tick() >= bossProbeAt then
                            if #live == 0 then bossProbeAt = tick() + 12 end -- only a pass that really goes for the boss uses the probe
                        else
                            for k = #bosses, 1, -1 do bosses[k] = nil end
                        end
                    end
                end
                if not (armoredFirst and #live > 0) then
                    for _, b in ipairs(bosses) do live[#live+1] = b end
                end
                if #live == 0 then
                    stats.state = "Waiting for titans"
                    task.wait(0.5)
                    return
                end
                stats.state = "Killing"
                -- up
                local top = P + Vector3.new(0, RISE, 0)
                glide(top, SPEED)
                if not farmOn() or busy then return end
                -- down at speed, swing so it is released just inside the top of the box, then register every neck
                local half = STACK / 2
                local hold = math.max(tonumber(S.SwingHold) or 0.1, 0.05)
                local landing = P + Vector3.new(0, 5, 0)
                local dur = (top - landing).Magnitude / SPEED
                local relAt = (RISE - (half - 20)) / SPEED
                local pressAt = math.max(0, relAt - hold)
                local t0, down, released = tick(), false, false
                wantVel = Vector3.new(0, -SPEED, 0)
                while farmOn() and not busy do
                    local el = tick() - t0
                    if el >= dur then break end
                    want = CFrame.new(top + Vector3.new(0, -SPEED * el, 0))
                    if not down and el >= pressAt and not inCutscene() then down = true; mouseDown() end
                    if down and not released and el >= relAt then
                        released = true
                        mouseUp()
                        task.delay(0.01, function() if not inCutscene() then registerAll(live, hold) end end)
                    end
                    RunService.Heartbeat:Wait()
                end
                if down and not released then mouseUp() end
                want = CFrame.new(landing)
                wantVel = Vector3.zero
                task.wait(0.5)
            end)
            if not ok then
                stats.state = "Error: " .. tostring(err):sub(1, 40)
                task.wait(1)
            end
        end
        drive:Disconnect()
        stackRelease()
        local hrp = myHrp()
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        if not busy then stats.state = "Idle" end
        killing = false
    end)
end
end

-- ===== auto farm v2: skill projectile + every titan's neck hitbox moved onto it (no flying) =====
-- Method (from the reference script): fire the equipped skills (Thrust / Steel / Let it RIP). When the game spawns the
-- skill's projectile Part in workspace (named "<Player>_Thrust" / "_Steel" / "_RIP"), every titan's Nape hitbox is made
-- huge and moved onto that Part, so the skill's one hit lands on all necks at once. After ~2s the napes go back.
local SKILL_IDS = { "108", "14", "23", "14" }
local farm2Running = false
local napeHome = setmetatable({}, { __mode = "k" })
local function skillProjectile(p)
    return p.Name == lp.Name .. "_Steel" or p.Name == lp.Name .. "_Thrust" or p.Name == lp.Name .. "_RIP"
end
local function allNapes()
    local list = {}
    for _, t in ipairs(titans()) do
        if not titanDown(t) then
            local hit = hitFolder(t)
            local nape = hit and hit:FindFirstChild("Nape")
            if nape and nape:IsA("BasePart") then list[#list+1] = nape end
        end
    end
    return list
end
local function pullNapesTo(proj)
    proj.Size = Vector3.new(125, 125, 125)
    local t0 = tick()
    while S.AutoFarm2 and proj.Parent and tick() - t0 < 2 do
        for _, nape in ipairs(allNapes()) do
            napeHome[nape] = napeHome[nape] or nape.CFrame
            remember(nape)
            nape.Size = Vector3.new(150, 150, 150)
            nape.Transparency = 1
            nape.CanCollide = false
            nape.Position = proj.Position
        end
        task.wait(0.01)
    end
    -- put the necks back where they belong
    task.wait(0.5)
    for nape, cf in pairs(napeHome) do
        if nape.Parent then nape.CFrame = cf end
        napeHome[nape] = nil
    end
    restoreHitbox()
end
conns[#conns+1] = workspace.ChildAdded:Connect(function(child)
    if S.AutoFarm2 and child:IsA("Part") and skillProjectile(child) then
        task.spawn(pullNapesTo, child)
    end
end)
local function farm2Loop()
    if farm2Running then return end
    farm2Running = true
    task.spawn(function()
        while S.AutoFarm2 do
            if titanFolder() and #allNapes() > 0 then
                stats.state = "Farm v2"
                local t0 = tick()
                while S.AutoFarm2 and tick() - t0 < 3.5 do
                    invoke("S_Skills", "Usage", SKILL_IDS[1]); task.wait(0.1)
                    invoke("S_Skills", "Usage", SKILL_IDS[2]); task.wait(2.5)
                    invoke("S_Skills", "Usage", SKILL_IDS[3]); task.wait(0.1)
                    invoke("S_Skills", "Usage", SKILL_IDS[4]); task.wait(0.5)
                end
            else
                stats.state = "Waiting for titans"
                task.wait(0.5)
            end
        end
        if not S.AutoKill then stats.state = "Idle" end
        farm2Running = false
    end)
end

-- ===== far kill (hit all, no flying) =====
-- Every live titan's nape hitbox is pulled next to the player (client side, same trick as Farm v2) and a hit is
-- registered on each one, so the whole map dies without moving. Titans that take no damage for 5s are skipped for 10s.
local farRunning = false
local farHome = setmetatable({}, { __mode = "k" })
local farSkip = setmetatable({}, { __mode = "k" })
local function farPutBack()
    for nape, cf in pairs(farHome) do
        if nape.Parent then nape.CFrame = cf end
        farHome[nape] = nil
    end
end
local function farLoop()
    if farRunning then return end
    farRunning = true
    task.spawn(function()
        local hpSeen = setmetatable({}, { __mode = "k" })
        while S.FarKill do
            local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not hrp or not titanFolder() then
                stats.state = "Waiting for titans"
                task.wait(0.5)
            else
                local n = 0
                for _, t in ipairs(titans()) do
                    if not titanDown(t) and (farSkip[t] or 0) < tick() then
                        local hit = hitFolder(t)
                        local nape = hit and hit:FindFirstChild("Nape")
                        if nape and nape:IsA("BasePart") then
                            n += 1
                            if S.FarBring then
                                farHome[nape] = farHome[nape] or nape.CFrame
                                remember(nape)
                                nape.Size = Vector3.new(S.FarmNape, S.FarmNape, S.FarmNape)
                                nape.Transparency = 1
                                nape.CanCollide = false
                                nape.CFrame = hrp.CFrame * CFrame.new(0, -4, 0)
                            end
                            task.spawn(hitNape, nape)
                            -- stuck check: no health change for 5s
                            local hum = t:FindFirstChildOfClass("Humanoid")
                            local rec = hpSeen[t]
                            local hp = hum and hum.Health
                            if not rec or rec.hp ~= hp then hpSeen[t] = { hp = hp, at = tick() }
                            elseif tick() - rec.at > 5 then farSkip[t] = tick() + 10; hpSeen[t] = nil end
                        end
                    end
                end
                stats.state = n > 0 and "Far kill" or "Waiting for titans"
                task.wait(1 / math.max(S.FarHitsPerSec, 1))
                -- necks go back between volleys so titans are never left broken
                farPutBack()
            end
        end
        farPutBack()
        restoreHitbox()
        if not S.AutoKill and not S.AutoFarm2 then stats.state = "Idle" end
        farRunning = false
    end)
end

-- ===== auto retry (rewards screen: vote to play again) =====
