local function b64bytes(str)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end
    local data = string.gsub(str, "[^%w%+/]", "")
    local bytes, buffer, count = {}, 0, 0
    for i = 1, #data do
        buffer = buffer * 64 + lookup[string.byte(data, i)]
        count += 1
        if count == 4 then
            bytes[#bytes+1] = string.char(math.floor(buffer / 65536) % 256, math.floor(buffer / 256) % 256, buffer % 256)
            buffer, count = 0, 0
        end
    end
    if count == 3 then
        buffer = buffer * 64
        bytes[#bytes+1] = string.char(math.floor(buffer / 65536) % 256, math.floor(buffer / 256) % 256)
    elseif count == 2 then
        buffer = buffer * 4096
        bytes[#bytes+1] = string.char(math.floor(buffer / 65536) % 256)
    end
    return table.concat(bytes)
end
