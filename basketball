-- Auto: spin families until a wanted one lands
-- Drives the game's own Customisation > Family > ROLL button (one fire = one roll). The current family is read from
-- Family.Family.Title ("HUME (Common)"), the spins left from the ROLL button text ("ROLL (8)", ".." while rolling).
-- =====================================================================
local FAMILIES = {
    "Blouse", "Boyega", "Bozado", "Hume", "Iglehaut", "Inocenio", "Munsell", "Pikale", "Ral", "Reeves",
    "Azumabito", "Braus", "Grice", "Kirstein", "Kruger", "Smith", "Springer",
    "Arlert", "Braun", "Finger", "Galliard", "Ksaver", "Leonhart", "Tybur", "Zoe",
    "Ackerman", "Reiss", "Yeager", "Fritz", "Helos", "Shiki",
}
local A = { Want = {}, Auto = false, Delay = 0.4, Rolls = 0 }
local function familyUI()
    local c = iface() and iface():FindFirstChild("Customisation")
    return c and c:FindFirstChild("Family")
end
local function currentFamily()
    local f = familyUI()
    local t = f and f:FindFirstChild("Family") and f.Family:FindFirstChild("Title")
    return t and t.Text:match("^%s*([%w_']+)")
end
function A.title()
    local f = familyUI()
    local t = f and f:FindFirstChild("Family") and f.Family:FindFirstChild("Title")
    return t and t.Text
end
local function rollTitle()
    local f = familyUI()
    local b = f and f:FindFirstChild("Buttons_2") and f.Buttons_2:FindFirstChild("Roll")
    return b and b:FindFirstChild("Title")
end
local function spinsLeft()
    local t = rollTitle()
    return t and tonumber(t.Text:match("%((%d+)%)"))
end
local function wanted(name)
    if not name then return false end
    for _, w in ipairs(A.Want) do if w:lower() == name:lower() then return true end end
    return false
end
local spinning = false
local function spinLoop()
    if spinning then return end
    spinning = true
    task.spawn(function()
        local function stop(msg)
            A.Auto = false
            pcall(function() if Library.SetFlags["a_auto"] then Library.SetFlags["a_auto"](false) end end)
            notify(msg)
            if S.WhFam then Hook.summary(msg) end
        end
        while A.Auto do
            local f = familyUI()
            if not f then stop("Auto spin: family menu not found") break end
            if #A.Want == 0 then stop("Auto spin: pick at least one family first") break end
            local cur = currentFamily()
            if wanted(cur) then stop("Auto spin: you got " .. cur .. "!") break end
            local left = spinsLeft()
            if left == 0 then stop("Auto spin: out of spins (last family " .. tostring(cur) .. ")") break end
            if left == nil then task.wait(0.2) else -- nil = a roll is still animating (button reads "..")
                local title = rollTitle()
                local before = title.Text
                if firesignal then pcall(firesignal, f.Buttons_2.Roll.MouseButton1Click) end
                A.Rolls += 1
                local t0 = tick()
                repeat task.wait(0.1) until not A.Auto or tick() - t0 > 8 or (title.Text ~= before and spinsLeft() ~= nil)
                if S.WhFam and title.Text ~= before then Hook.family(A.title(), spinsLeft(), wanted(currentFamily())) end
                task.wait(A.Delay)
            end
        end
        spinning = false
    end)
end

