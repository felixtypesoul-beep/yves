        conns[#conns+1] = f.ChildAdded:Connect(function(t) task.spawn(watchTitan, t) end)
        conns[#conns+1] = f.ChildRemoved:Connect(function(t)
            local hum = t:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then markSlain(t) end
        end)
    end
end

-- ===== hitbox expander =====
local original = setmetatable({}, { __mode = "k" })
-- farm neck hitbox size comes from S.FarmNape
local function remember(p)
    original[p] = original[p] or { p.Size, p.Transparency, p.CanCollide, p.CanTouch, p.CanQuery }
end
-- Auto farm forces the neck hitbox to S.FarmNape (the game's own "nape extend" trick); the manual part/size settings apply otherwise.
local function applyHitbox()
    local farm = S.AutoKill
    local size = farm and S.FarmNape or S.HitboxSize
    for _, t in ipairs(titans()) do
        local list = hitParts(t)
        if farm then
            local hit = hitFolder(t)
            local nape = hit and hit:FindFirstChild("Nape")
            list = nape and { nape } or {}
        end
        for _, p in ipairs(list) do
            remember(p)
            p.Size = Vector3.new(size, size, size)
            p.Transparency = S.ShowNapes and 0.6 or 1
            p.CanCollide = false
        end
    end
end
local function restoreHitbox()
    for p, o in pairs(original) do
        if p.Parent then p.Size, p.Transparency, p.CanCollide, p.CanTouch, p.CanQuery = o[1], o[2], o[3], o[4], o[5] end
        original[p] = nil
    end
end

