		-- Dash.SetPlan("Free", false) / Dash.SetExpires("23h 58m") / Dash.SetLocation("Lobby") / Dash.SetStatus("Idle", false)
		-- local sec = Dash:Section("Session", 4); local tile = sec:Tile("LEVEL", "53"); tile:SetText("54")
		Library.Dashboard = function(Self, Params)
			Params = Params or { }
			local ThemeRef = Library.Theme

			local Page = Self
			local Dash = { Items = { } }
			local LocalPlayer = game:GetService("Players").LocalPlayer
			local Gold = Library.Theme["Accent"]

			for _, Column in {"LeftColumn", "RightColumn"} do
				Page.Items[Column].Instance.Visible = false
			end

			local Scroll = Library:Create("ScrollingFrame", {
				Name = "\0",
				Parent = Page.Items["Page"].Instance,
				Active = true,
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 0,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				BorderSizePixel = 0,
				CanvasSize = UDim2.new(0, 0, 0, 0)
			})

			Library:Create("UIPadding", {Name = "\0", Parent = Scroll.Instance, PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3)})
			Library:Create("UIListLayout", {Name = "\0", Parent = Scroll.Instance, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})

			local Order = 0

			local ThemeRef = Library.Theme
			local Black = Color3.new(0, 0, 0)
			local CardGradient = function()
				return ColorSequence.new(Color3.fromRGB(255, 252, 246), Color3.fromRGB(190, 180, 164))
			end
			-- banner + profile card: one colour (Settings > Theming > Header Color), shaded left to right
			local HeaderGradient = function()
				local C = ThemeRef["Header Color"]
				return ColorSequence.new{
					ColorSequenceKeypoint.new(0, C),
					ColorSequenceKeypoint.new(0.55, C:Lerp(Black, 0.7)),
					ColorSequenceKeypoint.new(1, C:Lerp(Black, 0.9))
				}
			end

			local Box = function(Parent, Height, Auto, Mode)
				Order += 1

				local Frame = Library:Create("Frame", {
					Name = "\0",
					Parent = Parent,
					LayoutOrder = Order,
					Size = UDim2.new(1, 0, 0, Height),
					AutomaticSize = Auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
					BorderSizePixel = 0,
					ClipsDescendants = true,
					BackgroundColor3 = Mode == "header" and Color3.new(1, 1, 1) or Library.Theme["Section Box"]
				})

				if Mode ~= "header" then
					Frame:AddToTheme({BackgroundColor3 = 'Section Box'})
				end

				Library:Create("UICorner", {Name = "\0", Parent = Frame.Instance, CornerRadius = UDim.new(0, 6)})

				Library:ThemeGradient(Frame, Mode == "header" and HeaderGradient or CardGradient, Mode == "header" and 0 or 90)

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Frame.Instance,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Color = Library.Theme["Outline 1"]
				}):AddToTheme({Color = 'Outline 1'})

				return Frame
			end

			local Text = function(Parent, Props)
				Props.Name = "\0"
				Props.Parent = Parent
				Props.BackgroundTransparency = 1
				Props.BorderSizePixel = 0
				Props.FontFace = Props.FontFace or Library.Font
				Props.TextSize = Props.TextSize or Library.FontSize
				Props.TextColor3 = Props.TextColor3 or Library.Theme["Text"]
				Props.TextXAlignment = Props.TextXAlignment or Enum.TextXAlignment.Left
				return Library:Create("TextLabel", Props)
			end

			-- banner
			do
				local Banner = Box(Scroll.Instance, Params.BannerHeight or 112, nil, "header")
				Dash.Items["Banner"] = Banner
				

				-- game thumbnail (set with Dash.SetBannerImage), faded into the dark gradient on the left like the reference
				local BannerImage = Library:Create("ImageLabel", {
					Name = "\0",
					Parent = Banner.Instance,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 1, 0),
					Image = Params.BannerImage or "",
					ScaleType = Enum.ScaleType.Crop,
					ImageTransparency = Params.BannerImage and 0 or 1
				})

				Library:Create("UICorner", {Name = "\0", Parent = BannerImage.Instance, CornerRadius = UDim.new(0, 6)})

				local Shade = Library:Create("Frame", {
					Name = "\0",
					Parent = Banner.Instance,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundColor3 = Color3.fromRGB(8, 6, 4)
				})

				Library:Create("UICorner", {Name = "\0", Parent = Shade.Instance, CornerRadius = UDim.new(0, 6)})

				Library:Create("UIGradient", {
					Name = "\0",
					Parent = Shade.Instance,
					Rotation = 0,
					Transparency = NumberSequence.new{
						NumberSequenceKeypoint.new(0, 0.04),
						NumberSequenceKeypoint.new(0.45, 0.35),
						NumberSequenceKeypoint.new(1, 0.9)
					}
				})

				-- gold glow along the bottom edge
				local Glow = Library:Create("Frame", {
					Name = "\0",
					Parent = Banner.Instance,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, 0),
					Size = UDim2.new(1, 0, 0, 2),
					BorderSizePixel = 0,
					BackgroundColor3 = Library.Theme["Accent"]
				})

				Library:Create("UIGradient", {
					Name = "\0",
					Parent = Glow.Instance,
					Transparency = NumberSequence.new{
						NumberSequenceKeypoint.new(0, 0.1),
						NumberSequenceKeypoint.new(1, 1)
					}
				})

				Dash.SetBannerImage = function(Asset)
					if Asset and Asset ~= "" then
						BannerImage.Instance.Image = Asset
						BannerImage.Instance.ImageTransparency = 0
					end
				end

				Text(Banner.Instance, {
					Position = UDim2.new(0, 14, 0, 12), Size = UDim2.new(1, -28, 0, 16),
					Text = Params.BannerKicker or "WELCOME BACK", TextColor3 = Gold, TextSize = Library.FontSize + 1, FontFace = Library.BoldFont
				})

				local Title = Text(Banner.Instance, {
					Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -28, 0, 30),
					Text = string.upper(Params.BannerTitle or "Yves Hub"), FontFace = Library.BoldFont, TextSize = Library.FontSize + 10
				})

				Text(Banner.Instance, {
					Position = UDim2.new(0, 14, 1, -22), Size = UDim2.new(1, -28, 0, 12),
					Text = Params.BannerTag or "", TextColor3 = Library.Theme["Inactive Text"], TextSize = Library.FontSize - 3
				})

				Dash.SetBanner = function(Kicker, TitleText, Tag)
					local Kids = Banner.Instance:GetChildren()
					local Labels = { }

					for _, Child in Kids do
						if Child:IsA("TextLabel") then
							table.insert(Labels, Child)
						end
					end

					if Labels[1] and Kicker then Labels[1].Text = Kicker end
					if Labels[2] and TitleText then Labels[2].Text = string.upper(TitleText) end
					if Labels[3] and Tag then Labels[3].Text = Tag end
				end
			end

			-- profile card
			do
				local Card = Box(Scroll.Instance, 82, nil, "header")
				Dash.Items["Profile"] = Card

				local Avatar = Library:Create("ImageLabel", {
					Name = "\0",
					Parent = Card.Instance,
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 14, 0.5, 0),
					Size = UDim2.new(0, 56, 0, 56),
					BorderSizePixel = 0,
					BackgroundColor3 = Library.Theme["Element"],
					Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(LocalPlayer and LocalPlayer.UserId or 1) .. "&w=150&h=150"
				}):AddToTheme({BackgroundColor3 = 'Element'})

				Library:Create("UICorner", {Name = "\0", Parent = Avatar.Instance, CornerRadius = UDim.new(1, 0)})

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Avatar.Instance,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Thickness = 2,
					Color = Library.Theme["Accent"]
				}):AddToTheme({Color = 'Accent'})

				Text(Card.Instance, {
					Position = UDim2.new(0, 82, 0, 14), Size = UDim2.new(0, 150, 0, 20),
					Text = LocalPlayer and (LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name) or "player",
					FontFace = Library.BoldFont, TextSize = Library.FontSize + 4, TextTruncate = Enum.TextTruncate.AtEnd
				})

				Text(Card.Instance, {
					Position = UDim2.new(0, 82, 0, 35), Size = UDim2.new(0, 150, 0, 14),
					Text = "@" .. (LocalPlayer and string.lower(LocalPlayer.Name) or "player"),
					TextColor3 = Library.Theme["Inactive Text"], TextSize = Library.FontSize - 2, TextTruncate = Enum.TextTruncate.AtEnd
				})

				local Pill = Library:Create("Frame", {
					Name = "\0",
					Parent = Card.Instance,
					Position = UDim2.new(0, 82, 0, 54),
					Size = UDim2.new(0, 0, 0, 20),
					AutomaticSize = Enum.AutomaticSize.X,
					BorderSizePixel = 0,
					BackgroundColor3 = Library.Theme["Accent"]
				})

				Library:Create("UICorner", {Name = "\0", Parent = Pill.Instance, CornerRadius = UDim.new(1, 0)})
				Library:Create("UIPadding", {Name = "\0", Parent = Pill.Instance, PaddingLeft = UDim.new(0, 22), PaddingRight = UDim.new(0, 22)})

				local PillGrad = Library:Create("UIGradient", {Name = "\0", Parent = Pill.Instance, Rotation = 90})

				local PillStroke = Library:Create("UIStroke", {
					Name = "\0",
					Parent = Pill.Instance,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Color = Library.Theme["Accent"]
				})

				local PillText = Text(Pill.Instance, {
					Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "FREE",
					FontFace = Library.BoldFont, TextSize = Library.FontSize - 1, TextColor3 = Color3.fromRGB(52, 26, 4),
					TextXAlignment = Enum.TextXAlignment.Center
				})

				-- Free = orange pill (Settings > Theming > Plan Pill), Premium = pill in the accent colour
				local PillPremium = false
				local PillColors = function()
					local C = ThemeRef[PillPremium and "Accent" or "Plan Pill"]
					return ColorSequence.new(C:Lerp(Color3.new(1, 1, 1), 0.3), C:Lerp(Black, 0.22))
				end

				Library.AddToTheme({Instance = PillGrad.Instance}, {Color = PillColors})

				Dash.SetPlan = function(Name, Premium)
					PillText.Instance.Text = string.upper(tostring(Name or "FREE"))
					PillPremium = Premium and true or false
					Pill.Instance.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					PillGrad.Instance.Color = PillColors()
					PillStroke.Instance.Color = ThemeRef[PillPremium and "Accent" or "Plan Pill"]:Lerp(Color3.new(1, 1, 1), 0.35)
					PillText.Instance.TextColor3 = Color3.fromRGB(52, 26, 4)
				end

				Dash.SetPlan("Free", false)

				local Stack = function(Right, Label, Value, Color)
					Text(Card.Instance, {
						AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -Right, 0, 18), Size = UDim2.new(0, 96, 0, 12),
						Text = Label, TextColor3 = Library.Theme["Inactive Text"], TextSize = Library.FontSize - 4, TextXAlignment = Enum.TextXAlignment.Right
					})

					return Text(Card.Instance, {
						AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -Right, 0, 32), Size = UDim2.new(0, 96, 0, 18),
						Text = Value, TextColor3 = Color or Library.Theme["Text"], FontFace = Library.BoldFont, TextXAlignment = Enum.TextXAlignment.Right
					})
				end

				local Expires = Stack(210, "EXPIRES", "-")
				local Location = Stack(112, "LOCATION", "-")
				local Status = Stack(14, "STATUS", "Idle", Library.Theme["Inactive Text"])

				Dash.SetExpires = function(T) Expires.Instance.Text = tostring(T) end
				Dash.SetLocation = function(T) Location.Instance.Text = tostring(T) end
				Dash.SetStatus = function(T, Active)
					Status.Instance.Text = tostring(T)
					Status.Instance.TextColor3 = Active and Color3.fromRGB(80, 220, 120) or ThemeRef["Inactive Text"]
				end
			end

			-- stat sections (diamond + gold caps title, grid of tiles)
			Dash.Section = function(Self2, Name, Columns)
				Columns = Columns or 4

				local Pad = 8
				local Sec = { Items = { } }
				local Card = Box(Scroll.Instance, 0, true)

				Library:Create("UIListLayout", {Name = "\0", Parent = Card.Instance, Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder})

				local Head = Library:Create("Frame", {
					Name = "\0", Parent = Card.Instance, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, BorderSizePixel = 0
				})

				Library:StarIcon(Head.Instance, 18, UDim2.new(0, 19, 0.5, 0))

				Text(Head.Instance, {
					AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 32, 0.5, 0), Size = UDim2.new(1, -40, 0, 24),
					Text = string.upper(Name), TextSize = Library.FontSize + 6, FontFace = Library.BoldFont, TextColor3 = Library.Theme["Accent"]
				}):AddToTheme({TextColor3 = 'Accent'})

				local Wrap = Library:Create("Frame", {
					Name = "\0", Parent = Card.Instance, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0
				})

				Library:Create("UIPadding", {Name = "\0", Parent = Wrap.Instance, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10)})

				Library:Create("UIGridLayout", {
					Name = "\0",
					Parent = Wrap.Instance,
					CellSize = UDim2.new(1 / Columns, -(Pad * (Columns - 1) / Columns), 0, 46),
					CellPadding = UDim2.new(0, Pad, 0, Pad),
					SortOrder = Enum.SortOrder.LayoutOrder
				})

				local Count = 0

				Sec.Tile = function(Self3, Label, Value)
					Count += 1

					local Tile = Library:Create("Frame", {
						Name = "\0", Parent = Wrap.Instance, LayoutOrder = Count, BorderSizePixel = 0,
						BackgroundColor3 = Library.Theme["Inline"]
					}):AddToTheme({BackgroundColor3 = 'Inline'})

					Library:Create("UICorner", {Name = "\0", Parent = Tile.Instance, CornerRadius = UDim.new(0, 5)})

					Library:Create("UIStroke", {
						Name = "\0", Parent = Tile.Instance, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = Library.Theme["Outline 2"]
					}):AddToTheme({Color = 'Outline 2'})

					Text(Tile.Instance, {
						Position = UDim2.new(0, 10, 0, 7), Size = UDim2.new(1, -16, 0, 11),
						Text = string.upper(Label), TextColor3 = Library.Theme["Inactive Text"], TextSize = Library.FontSize - 4
					})

					local Val = Text(Tile.Instance, {
						Position = UDim2.new(0, 10, 0, 21), Size = UDim2.new(1, -16, 0, 18),
						Text = tostring(Value or "-"), FontFace = Library.BoldFont, TextSize = Library.FontSize + 3, TextTruncate = Enum.TextTruncate.AtEnd
					})

					return {
						Instance = Tile.Instance,
						SetText = function(_, T) Val.Instance.Text = tostring(T) end
					}
				end

				return Sec
			end

			return Dash
		end


		Library.MultiSection = function(Self, Params)
			Params = Params or { }

			local Resizable = Params.Resizable

			if Resizable == nil then
				Resizable = Params.resizable
			end

			if Resizable == nil then
				Resizable = true
			end

			local CanPopOut = Params.PopOut

			if CanPopOut == nil then
				CanPopOut = Params.popout
			end

			if CanPopOut == nil then
				CanPopOut = true
			end

			local MultiSection = {
				Side = Params.Side or Params.side or 1,
				Height = Params.Height or Params.height or 150,
				MinimumHeight = Params.MinimumHeight or Params.minimumheight or 80,
				MaximumHeight = Params.MaximumHeight or Params.maximumheight or 600,
				Resizable = Resizable,
				CanPopOut = CanPopOut,
				Popped = false,
				Window = Self.Window,
				Page = Self,
				Items = { },
				Current = nil,
				Sections = { }
