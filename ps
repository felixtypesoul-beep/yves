			end

			if not Library.TrackedRows[Frame] then
				Library.TrackedRows[Frame] = true

				Library:Connect(Frame:GetPropertyChangedSignal("AbsoluteSize"), function()
					Library:LayoutRow(Frame)
				end)
			end

			Library:LayoutRow(Frame)
		end

