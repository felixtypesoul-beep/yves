					local Samples = math.clamp(Graph.MaxPoints, 8, 64)
					local Data = { }

					for Index = 1, Samples do
						Data[Index] = Graph.Editor:Evaluate((Index - 1) / (Samples - 1) * 100)
					end

					Graph:SetData(Data)
				end

				function Graph:BuildEditor()
					if Graph.Editor then
