						RowNudge:Tween({PaddingLeft = UDim.new(0, 0)}, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))

						if Colorpicker.AnimationMode ~= Mode then
							Row:Tween({TextColor3 = Library.Theme["Inactive Text"]})
