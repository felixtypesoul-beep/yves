					Row:OnHover(function()
						RowNudge:Tween({PaddingLeft = UDim.new(0, 5)}, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))

						if Colorpicker.AnimationMode ~= Mode then
