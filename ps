			function Page:Turn()
				local Old = Page.Window.Current

				if Old == Page then
					return
				end

				if Page.Debounce then
					return
				end

				if Old and Old.Debounce then
					return
				end

				Page.Debounce = true

				if Old then
					Old.Items["Text"].Instance.FontFace = Library.Font
					Old.Items["Text"]:Tween({TextTransparency = 0.28})

					if Old.Items["Glyph"] then
						Old.Items["Glyph"]:ChangeItemTheme({ImageColor3 = "Text"})
						Old.Items["Glyph"]:Tween({ImageColor3 = Library.Theme["Text"], ImageTransparency = 0.3})
					end

					Old.Items["Bar"].Instance.Visible = false
					Old.Items["Inactive"]:Tween({BackgroundTransparency = 1})

					Old.Items["Page"]:FadeDescendants(false, function()
						Old.Items["Page"].Instance.Parent = Library.UnusedHolder.Instance
					end)
				end

				Items["Page"].Instance.Parent = Page.Window.Items["Content"].Instance
				Items["Page"].Instance.Visible = true
				Items["Page"]:FadeDescendants(true, function()
					Page.Debounce = false
				end)

				Items["Text"].Instance.FontFace = Library.BoldFont
				Items["Text"]:Tween({TextTransparency = 0})

				if Items["Glyph"] then
					Items["Glyph"]:ChangeItemTheme({ImageColor3 = "Accent"})
					Items["Glyph"]:Tween({ImageColor3 = Library.Theme["Accent"], ImageTransparency = 0})
				end

				Items["Bar"].Instance.Visible = true
				Items["Inactive"]:Tween({BackgroundTransparency = 0.45})

				if Page.Window.SetCrumb then
					Page.Window.SetCrumb(Page.Name, Page.Icon, Page.Group, Page.Sub)
				end

				Page.Window.Current = Page
			end

			Items["Inactive"]:Connect("MouseButton1Down", function()
				Page:Turn()
			end)

			Items["Inactive"]:Connect("MouseEnter", function()
				if Page.Window.Current ~= Page then
					Items["Inactive"]:Tween({BackgroundTransparency = 0.75})
				end
			end)

			Items["Inactive"]:Connect("MouseLeave", function()
				if Page.Window.Current ~= Page then
					Items["Inactive"]:Tween({BackgroundTransparency = 1})
				end
			end)

			if #Page.Window.Pages == 0 then
				Page:Turn()
			end

			table.insert(Page.Window.Pages, Page)
			return setmetatable(Page, Library)
		end

