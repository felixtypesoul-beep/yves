				Window.SearchHidden = { }
				Window.SearchToken = 0

				-- lower-cased text of everything readable inside an element row
				local ElementText = function(Row)
					local Parts = { }

					for _, Descendant in Row:GetDescendants() do
						if Descendant:IsA("TextLabel") or Descendant:IsA("TextButton") then
							if Descendant.Text ~= "" then
								table.insert(Parts, Descendant.Text)
							end
						end
					end

					if Row:IsA("TextButton") and Row.Text ~= "" then
						table.insert(Parts, Row.Text)
					end

					if Row:IsA("TextLabel") and Row.Text ~= "" then
						table.insert(Parts, Row.Text)
					end

					return string.lower(table.concat(Parts, " "))
				end

				local RunFilter = function()
					local Query = string.lower(string.match(Items["SearchBox"].Instance.Text or "", "^%s*(.-)%s*$"))

					for Frame in Window.SearchHidden do
						if Frame.Parent then
							Frame.Visible = true
						end
					end

					table.clear(Window.SearchHidden)
					table.clear(Window.NavVisible)

					for _, Data in Window.Groups do
						for _, Entry in Data.Pages do
							local NameMatch = Query == "" or string.find(string.lower(Entry.Name), Query, 1, true) ~= nil
							local Hits = 0
							local Pending = { }

							if Query ~= "" then
								for _, ColumnName in {"LeftColumn", "RightColumn"} do
									local Column = Entry.Items[ColumnName]

									if Column then
										for _, SectionFrame in Column.Instance:GetChildren() do
											if SectionFrame:IsA("Frame") then
												local Content = SectionFrame:FindFirstChildOfClass("ScrollingFrame")
												local Rows = { }
												local Last = nil
												local SectionName = ""

												for _, Child in SectionFrame:GetChildren() do
													if Child:IsA("Frame") and Child ~= Content then
														for _, Label in Child:GetDescendants() do
															if Label:IsA("TextLabel") and Label.Text ~= "" then
																SectionName = string.lower(Label.Text)
																break
															end
														end

														break
													end
												end

												local SectionMatch = SectionName ~= "" and string.find(SectionName, Query, 1, true) ~= nil

												if Content then
													for _, Row in Content:GetChildren() do
														if Row:IsA("GuiObject") then
															local Matched = string.find(ElementText(Row), Query, 1, true) ~= nil

															if Row:GetAttribute("YvesDesc") and Last then
																if Matched then
																	Last.Match = true
																end

																table.insert(Rows, {Row = Row, Follow = Last})
															else
																Last = {Row = Row, Match = Matched}
																table.insert(Rows, Last)
															end
														end
													end
												end

												local SectionHits = 0

												for _, Item in Rows do
													if not Item.Follow and Item.Match then
														SectionHits += 1
													end
												end

												if SectionMatch then
													SectionHits = math.max(SectionHits, 1)
												end

												Hits += SectionHits
												table.insert(Pending, {Frame = SectionFrame, Rows = Rows, Hits = SectionHits, SectionMatch = SectionMatch})
											end
										end
									end
								end

								if not NameMatch and Hits > 0 then
									for _, Section in Pending do
										if Section.Hits == 0 then
											Section.Frame.Visible = false
											Window.SearchHidden[Section.Frame] = true
										elseif not Section.SectionMatch then
											for _, Item in Section.Rows do
												local Keep = Item.Follow and Item.Follow.Match or Item.Match

												if not Keep then
													Item.Row.Visible = false
													Window.SearchHidden[Item.Row] = true
												end
											end
										end
									end
								end
							end

							Window.NavVisible[Entry] = NameMatch or Hits > 0
						end
					end

					Window.RefreshNav()

					local Current = Window.Current

					if Current and Window.NavVisible[Current] == false then
						for _, Data in Window.Groups do
							for _, Entry in Data.Pages do
								if Window.NavVisible[Entry] then
									task.defer(function()
										Entry:Turn()
									end)

									return
								end
							end
						end
					end
				end

				Window.FilterPages = function()
					Window.SearchToken += 1

					local Token = Window.SearchToken

					task.delay(0.12, function()
						if Token == Window.SearchToken then
