		-- writes an inline base64 file to disk and returns a custom asset url (nil when the executor can not do it)
		Library.DecodeAsset = function(Self, FileName, Data)
			if Library.AssetCache[FileName] ~= nil then
				return Library.AssetCache[FileName] or nil
			end

			Library.AssetCache[FileName] = false

			pcall(function()
				local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
				local Lookup = { }

				for Index = 1, #Alphabet do
					Lookup[string.byte(Alphabet, Index)] = Index - 1
				end

				local Clean = string.gsub(Data, "[^%w%+/]", "")
				local Bytes = { }
				local Buffer, Count = 0, 0

				for Index = 1, #Clean do
					Buffer = Buffer * 64 + Lookup[string.byte(Clean, Index)]
					Count += 1

					if Count == 4 then
						table.insert(Bytes, string.char(math.floor(Buffer / 65536) % 256, math.floor(Buffer / 256) % 256, Buffer % 256))
						Buffer, Count = 0, 0
					end
				end

				if Count == 3 then
					Buffer = Buffer * 64
					table.insert(Bytes, string.char(math.floor(Buffer / 65536) % 256, math.floor(Buffer / 256) % 256))
				elseif Count == 2 then
					Buffer = Buffer * 4096
					table.insert(Bytes, string.char(math.floor(Buffer / 65536) % 256))
				end

				local Path = Library.Directory .. Library.Folders.Assets .. "/" .. FileName
				writefile(Path, table.concat(Bytes))
				Library.AssetCache[FileName] = getcustomasset(Path)
			end)

			return Library.AssetCache[FileName] or nil
		end

		-- blur + snow overlay while a window is open. The snow sits on a layer below every window,
		-- so the UI stays crisp. One RenderStepped connection moves a handful of tiny frames, which is cheap.
		Library.Effects = {
			Enabled = true,
			BlurSize = 14,
			SnowCount = IsMobile and 18 or 30
		}

		do
			local Lighting = game:GetService("Lighting")

			local Blur = nil
			local Snow = nil
			local Flakes = { }
			local Connection = nil
			local IsOn = false
			local Last = 0
			local Clock = 0

			local Build = function()
				if Snow then
					return
				end

				-- the snow lives inside the window (clipped to it), not over the whole screen
				Snow = Library:Create("Frame", {
					Name = "\0",
					Visible = false,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 1, 0),
					ClipsDescendants = true,
					ZIndex = 60,
					Active = false
				})

				Library:Create("UICorner", {Name = "\0", Parent = Snow.Instance, CornerRadius = UDim.new(0, 8)})

				local Rand = Random.new()

				for Index = 1, Library.Effects.SnowCount do
					local Size = Rand:NextInteger(2, 5)
					local Frame = Instance.new("Frame")

					Frame.AnchorPoint = Vector2.new(0.5, 0.5)
					Frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					Frame.BackgroundTransparency = Rand:NextNumber(0.2, 0.65)
					Frame.BorderSizePixel = 0
					Frame.Size = UDim2.fromOffset(Size, Size)

					local Corner = Instance.new("UICorner")
					Corner.CornerRadius = UDim.new(1, 0)
					Corner.Parent = Frame

					Frame.Parent = Snow.Instance

					Flakes[Index] = {
						Frame = Frame,
						X = Rand:NextNumber(),
						Y = Rand:NextNumber(),
						Speed = (0.05 + Size * 0.02) * Rand:NextNumber(0.8, 1.2),
						Sway = Rand:NextNumber(0.004, 0.02),
						Phase = Rand:NextNumber(0, 6.28),
						Rate = Rand:NextNumber(0.6, 1.6)
					}
				end
			end

			Library.SnowAttach = function(Parent)
				Build()
				Snow.Instance.Parent = Parent
			end

			local Step = function()
				local Now = os.clock()
				local Delta = math.min(Now - Last, 0.1)
				Last = Now
				Clock += Delta

				for _, Flake in Flakes do
					Flake.Y += Flake.Speed * Delta

					if Flake.Y > 1.04 then
						Flake.Y = -0.04
						Flake.X = math.random()
					end

					Flake.Frame.Position = UDim2.new(Flake.X + math.sin(Clock * Flake.Rate + Flake.Phase) * Flake.Sway, 0, Flake.Y, 0)
				end
			end

			local UnlockBound = false

			local SetUnlock = function(State)
				if State and not UnlockBound then
					UnlockBound = true

					RunService:BindToRenderStep("YvesUnlockMouse", Enum.RenderPriority.Last.Value, function()
						if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
							UserInputService.MouseBehavior = Enum.MouseBehavior.Default
						end

						UserInputService.MouseIconEnabled = true
					end)
				elseif not State and UnlockBound then
					UnlockBound = false
					pcall(RunService.UnbindFromRenderStep, RunService, "YvesUnlockMouse")
				end
			end

			Library.EffectsSet = function(State)
				SetUnlock(State and true or false)

				if Library.Effects.Enabled == false then
					State = false
				end

				State = State and true or false
				IsOn = State

				if State then
					Build()

					if false and not Blur then
						Blur = Instance.new("BlurEffect")
						Blur.Name = "\0"
						Blur.Size = 0
						Blur.Parent = Lighting
					end

					if Blur then Blur.Enabled = true end
					if Blur then TweenService:Create(Blur, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 0}):Play() end

					Snow.Instance.Visible = Library.Effects.Snow ~= false

					if not Connection then
						Last = os.clock()
						Connection = RunService.RenderStepped:Connect(Step)
					end
				else
					if Blur then
						local Fade = TweenService:Create(Blur, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 0})
						Fade:Play()

						Fade.Completed:Once(function()
							if Blur and not IsOn then
								Blur.Enabled = false
							end
						end)
					end

					if Snow then
						Snow.Instance.Visible = false
					end

					if Connection then
						Connection:Disconnect()
						Connection = nil
					end
				end
			end

			Library.EffectsDestroy = function()
				SetUnlock(false)
				IsOn = false

				if Connection then
					Connection:Disconnect()
					Connection = nil
				end

				if Blur then
					pcall(function()
						Blur:Destroy()
					end)

					Blur = nil
				end

				if Snow then
					pcall(function()
						Snow.Instance:Destroy()
					end)

					Snow = nil
				end

				table.clear(Flakes)
			end
		end

