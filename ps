		Library.LucideImage = function(Self, Parent, Name, Size, ThemeKey, Position, Fallback)
			Name = Library.IconAliases[Name] or Name
			local Icon = Library.LucideIcons[Name]
			local Host = Parent and (Parent.Instance or Parent)

			if not Icon or not Host then
				return nil
			end

			Position = Position or UDim2.new(0.5, 0, 0.5, 0)
			ThemeKey = ThemeKey or "Text"

			local Image = Library:Create("ImageLabel", {
				Name = "\0",
				Parent = Host,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = Position,
				Size = UDim2.new(0, Size, 0, Size),
				ZIndex = 3,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Image = "rbxassetid://" .. Icon[1],
				ImageRectSize = Vector2.new(48, 48),
				ImageRectOffset = Vector2.new(Icon[2], Icon[3]),
				ImageColor3 = Library.Theme[ThemeKey]
			}):AddToTheme({ImageColor3 = ThemeKey})

			if Fallback then
				Library:Thread(function()
					pcall(function()
						game:GetService("ContentProvider"):PreloadAsync({Image.Instance})
					end)

					local Tries = 0

					while Image.Instance.Parent and not Image.Instance.IsLoaded and Tries < 60 do
						Tries += 1
						task.wait(0.1)
					end

					if not Image.Instance.Parent or Image.Instance.IsLoaded then
						return
					end

					Image.Instance.ImageTransparency = 1

					local Text = Library:Create("TextLabel", {
						Name = "\0",
						Parent = Host,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = Position,
						Size = UDim2.new(0, Size, 0, Size),
						ZIndex = 3,
						BackgroundTransparency = 1,
						Text = Fallback,
						FontFace = Library.BoldFont,
						TextSize = Library.FontSize + 2,
						TextColor3 = Library.Theme[ThemeKey]
					}):AddToTheme({TextColor3 = ThemeKey})

					while Image.Instance.Parent and not Image.Instance.IsLoaded do
						task.wait(0.5)
					end

					if Image.Instance.Parent then
						Image.Instance.ImageTransparency = 0
					end

					pcall(function()
						Text.Instance:Destroy()
					end)
				end)
			end

			return Image
		end

